<%= form_with id: dom_id(goal_progress),
							model: [goal, goal_progress],
							builder: TailwindFormBuilder do |form| %>
  <div class="mb-3 flex space-x-3 items-center">
    <%= form.number_field :value, step: 0.01 %>
    <span class="block">/ <%= @goal.target_value %> <%= @goal.unit %></span>
  </div>
  <%= form.submit "Enregistrer le progrès", variant: :outline %>
<% end %>