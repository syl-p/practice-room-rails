<div id="<%= dom_id(progress) %>" class="flex items-center justify-between gap-3 px-4 py-3">
  <p class="text-sm font-semibold text-foreground">
    <%= progress.value %> <%= goal.unit %>
  </p>
  <p class="text-xs text-muted-foreground">
    <%= l(progress.created_at, format: :short) %>
  </p>
</div>