<header class="bg-secondary pt-20 pb-8 mb-6">
  <div class="container flex space-x-3">
    <div class="flex-1">
      <h1 class="text-3xl text-center">
        Tableau de bord
      </h1>
    </div>
  </div>
</header>
<section class="container">
  <nav>
    <ul class="flex flex-wrap space-x-3 items-center justify-center mb-8">
      <% (@start_at..@end_at).each do |wd| %>
        <li>
          <%= link_to dashboard_path(date: wd),
                      class: "block text-center p-2 rounded-full border relative #{'bg-primary-foreground' if wd == @current_date}" do %>
            <span class="block"><%= wd.day %></span>
            <span class="block text-sm"><%= I18n.l(wd, format: "%B") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <section>
    <div class="md:flex md:space-x-3 mb-6">
      <%= render partial: "dashboard/daily_stat", locals: {
        state: @stats[:more_than_10_mn_today][:state],
        goal: @stats[:more_than_10_mn_today][:goal],
        label_title: '10 minutes',
        label_subtitle: 'Au moins 10 minutes de pratique'
      } %>

      <%= render partial: "dashboard/daily_stat", locals: {
        state: @stats[:have_3_exercises_today][:state],
        goal: @stats[:have_3_exercises_today][:goal],
        label_title: '3 activitiés différentes',
        label_subtitle: 'Pratiquez au moins 3 activitités'
      } %>
    </div>
    <ul class="space-y-6">
      <% @practices.each do |practiced_activity| %>
        <li>
          <%= turbo_frame_tag dom_id(practiced_activity) do %>
            <%= render partial: "practiced_activities/item", locals: {practiced_activity:} %>
          <% end %>
        </li>
      <% end%>
    </ul>
  </section>
</section>
