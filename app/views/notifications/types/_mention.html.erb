<%= link_to activity_path(
            notification.notifiable.commentable,
            anchor: dom_id(notification.notifiable)),
            class: "tile #{'bg-secondary' unless notification.read_at.present?}",
            data: {turbo: false} do %>
  <div class="tile-icon">
    <%= render AvatarComponent.new(user: notification.notifiable.user) %>
  </div>
  <div class="tile-content">
    <p>
      <%= notification.notifiable.user.username %> vous a mentionné dans un commentaire.
      <small class="d-block">
        <%= notification.created_at %>
      </small>
    </p>
  </div>
<% end %>
