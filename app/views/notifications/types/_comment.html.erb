<%= link_to notification.notifiable.commentable,
            class: "flex w-full items-center space-x-3 px-4 py-2 #{'bg-secondary' unless notification.read_at.present?} hover:bg-muted",
            data: {turbo: false} do %>
  <div>
    <%= render AvatarComponent.new(user: notification.notifiable.user) %>
  </div>
  <div class="flex-1">
    <p class="block text-sm leading-normal text-muted-foreground antialiased mb-1">
      <span class="font-semibold text-foreground">
        <%= notification.notifiable.user.username %>
      </span>&nbsp;a posté un commentaire sur votre activité.
    </p>
    <p class="flex items-center gap-1 text-xs font-light text-muted-foreground antialiased">
      il y a <%= time_ago_in_words notification.created_at %>
    </p>
  </div>
<% end %>