<%= link_to notification.notifiable.commentable,
            class: "tile #{'bg-secondary' unless notification.read_at.present?}",
            data: {turbo: false} do %>
  <div class="tile-icon">
    <%= render AvatarComponent.new(user: notification.notifiable.user) %>
  </div>
  <div class="tile-content">
    <p>
      <%= notification.notifiable.user.username %> à posté un commentaire sur votre activité
      <small class="d-block">
        <%= notification.created_at %>
      </small>
    </p>
  </div>
<% end %>