<%# Locals: form_builder (f), activity %>
<div class="bg-background rounded-md -space-y-px">
	<% Activity.statuses.keys.each do |status| %>
		<label class="rounded-tl-md rounded-tr-md relative border p-4 flex cursor-pointer focus:outline-none"
		       for="<%= "activity_status_#{status.parameterize.underscore}" %>">
			<%= f.radio_button :status, status %>
			<span class="ml-3 flex flex-col">
        <span class="block text-sm font-medium"><%= status %></span>
      </span>
		</label>
	<% end %>
</div>