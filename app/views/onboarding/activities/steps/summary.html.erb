<%= turbo_frame_tag :remote_modal do %>
	<%= render "layouts/onboarding_dialog",
		model: @step_object,
		url: onboarding_activity_step_path(@activity, @step),
		method: :patch,
		header: render(partial: "onboarding/activities/steps/nav"),
		footer: ->(f) {
			tag.div(class: "flex items-center justify-between w-full") {
				concat ui_action_to("Précédent", onboarding_activity_step_path(@activity, Onboarding::Activity::STEPS[Onboarding::Activity::STEPS.index(@step) - 1]), as: :link, variant: :secondary)
				concat render(partial: "activities/attach_form", locals: { activity: @activity })
			}
		} do |f| %>
		<div class="flex flex-col items-center text-center">
			<div class="mb-4 rounded-full bg-primary/10 p-3">
				<%= icon "check-circle", class: "size-10 text-primary" %>
			</div>

			<h2 class="h2 mb-2">Félicitations !</h2>
			<p class="text-muted-foreground mb-6">
				Votre activité « <strong><%= @activity.title %></strong> » est prête.
			</p>

			<div class="w-full rounded-lg border border-border p-4 mb-6 text-left space-y-3">
				<div class="flex items-center justify-between">
					<span class="text-sm font-medium text-muted-foreground">Statut</span>
					<span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold
						<%= @activity.published? ? "bg-primary/10 text-primary" : "bg-secondary text-secondary-foreground" %>">
						<%= @activity.published? ? "Publiée" : "Brouillon" %>
					</span>
				</div>

				<% if @activity.tags.any? %>
					<div class="flex items-center justify-between">
						<span class="text-sm font-medium text-muted-foreground">Tags</span>
						<div class="flex flex-wrap gap-1 justify-end">
							<% @activity.tags.each do |tag| %>
								<%= render(TagComponent.new(tag.name, variant: :outline)) %>
							<% end %>
						</div>
					</div>
				<% end %>

				<% if @activity.media.any? %>
					<div class="flex items-center justify-between">
						<span class="text-sm font-medium text-muted-foreground">Médias</span>
						<span class="text-sm"><%= @activity.media.count %> fichier<%= "s" if @activity.media.count > 1 %></span>
					</div>
				<% end %>
			</div>

			<p class="text-sm text-muted-foreground mb-6">Souhaitez-vous l'ajouter à votre pratique ?</p>

			<p>
				<%= link_to "Plus tard",
										session["current_practice_id"] ? practice_activity_path(practice_id: session["current_practice_id"], id: @activity.id) : @activity,
										data: { turbo_frame: "_top" },
										class: "text-sm text-muted-foreground hover:text-foreground underline underline-offset-4" %>
			</p>
		</div>
	<% end %>
<% end %>