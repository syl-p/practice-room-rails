<% method = @activity.persisted? ? :patch : :post %>
<% url = @activity.persisted? ? onboarding_activity_step_path(@activity, @step) : onboarding_activities_path %>

<%= turbo_frame_tag :remote_modal do %>
	<%= render "layouts/onboarding_dialog",
		model: @step_object, url:, method:,
		header: render(partial: "onboarding/activities/steps/nav"),
		footer: ->(f) { f.submit "Suivant" } do |f| %>
		<fieldset class="mb-6">
			<legend>Contenu principal</legend>
			<%= render "onboarding/activities/forms/content_form", f:, activity: @activity %>
		</fieldset>
	<% end %>
<% end %>
