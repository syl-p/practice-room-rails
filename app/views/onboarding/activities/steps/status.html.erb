<% method = @activity.persisted? ? :patch : :post %>
<% url = @activity.persisted? ? onboarding_activity_step_path(@activity, @step) : onboarding_activities_path %>

<%= turbo_frame_tag :remote_modal do %>
	<%= render "layouts/onboarding_dialog",
		model: @step_object, url:, method:,
		header: render(partial: "onboarding/activities/steps/nav"),
		footer: ->(f) {
			tag.div(class: "flex items-center justify-between w-full") {
				concat ui_action_to("Précédent", onboarding_activity_step_path(@activity, Onboarding::Activity::STEPS[Onboarding::Activity::STEPS.index(@step) - 1]), as: :link, variant: :secondary)
				concat f.submit("Suivant")
			}
		} do |f| %>
		<fieldset class="mb-6">
			<legend>Visibilité</legend>
			<%= render "onboarding/activities/forms/status_form", f:, activity: @activity %>
		</fieldset>
	<% end %>
<% end %>
