<% method = @practice.persisted? ? :patch : :post %>
<% url = @practice.persisted? ? onboarding_practice_step_path(@practice, @step) : onboarding_practices_new_path %>

<%= turbo_frame_tag :remote_modal do %>
	<%= render "layouts/onboarding_dialog",
		model: @step_object, url:, method:,
		header: render(partial: "onboarding/practices/steps/nav"),
		footer: ->(f) {
			tag.div(class: "flex items-center justify-between w-full") {
				concat ui_action_to("Précédent", onboarding_practice_step_path(@practice, Onboarding::Practice::STEPS[Onboarding::Practice::STEPS.index(@step) - 1]), as: :link, variant: :secondary)
				concat f.submit("Suivant")
			}
		} do |f| %>
		<fieldset class="mb-6">
			<legend>Sélectionnez des tags</legend>
			<%= render "onboarding/practices/forms/tags_form", f:, practice: @practice %>
		</fieldset>
	<% end %>
<% end %>
