<% links = [
  {href: edit_settings_profile_path, name: "Vos informations"},
  {href: edit_settings_password_path, name: "Mot de passe"},
] %>

<nav aria-label="Paramètres du compte">
  <h2 class="h3 mb-3">Votre compte</h2>
  <ul class="flex md:flex-col gap-1">
    <% links.each do |link| %>
      <li class="flex-1 md:flex-none">
        <% active = current_page?(link[:href]) %>
        <%= link_to link[:name], link[:href],
                    aria: ({current: "page"} if active),
                    class: "block px-3 py-2 text-sm rounded-md transition-colors #{active ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}" %>
      </li>
    <% end %>
  </ul>
</nav>