<% mode = Current.user.favorites.find {|a| a.id === activity_id} ? :delete : :post %>
<%
  form_url = case mode
  when :post
    new_favorite_path(activity_id: activity_id)
    when :delete
      remove_favorite_path(activity_id: activity_id)
             end
%>
<%= turbo_frame_tag "favorite_btn_for_#{activity_id}" do %>
  <%= button_to form_url,
                class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(' '),
                method: mode do %>
    <%= mode == :post ? 'Ajouter aux favoris' : 'Supprimer des favoris' %>
  <% end %>
<% end %>