<%# Locals: medium, selected %>
<div id="<%= dom_id(medium) %>"
		 class="media-card <%= 'selected' if selected %>"
		 data-media-library-target="item">
  <label class="absolute inset-0 z-0 cursor-pointer" for="medium-<%= medium.id %>">
    <input type="checkbox"
           id="medium-<%= medium.id %>"
           class="sr-only peer"
           name="medium-<%= medium.id %>"
           value="<%= medium.id %>"
           <%= "checked" if selected %>
           data-media-selection-target="item"
           data-action="change->media-selection#toggle"
           data-media-selection-id-param="<%= medium.id %>" />

    <% if medium.file.representable? %>
      <%= image_tag medium.file.representation(resize_to_limit: [200, 200]),
                    alt: medium.file.filename,
                    class: "media-card-thumbnail" %>
    <% else %>
      <div class="media-card-thumbnail-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
      </div>
    <% end %>
  </label>

  <div class="media-card-overlay">
    <div class="media-card-checkbox">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <span class="media-card-filename"><%= medium.file.filename %></span>
  </div>

  <div class="media-card-dropdown">
    <%= render partial: "media/dropdown", locals: { medium: medium } %>
  </div>
</div>
