<div class="border p-3 rounded-lg shadow flex flex-col justify-between">
  <div class="flex space-x-3 items-center">
    <label for="medium-<%= medium.id %>">
      <input type="checkbox" class="peer"
             name="medium-<%= medium.id %>"
             value="<%= medium.id %>"
             <%= "checked" if selected %>
             data-media-selection-target="item" />
      <span class="sr-only">choisir ce media</span>
    </label>
    <p class="truncate flex-1"><%= medium.file.filename %></p>
    <%= render DropdownComponent.new(variant: :outline) do |component| %>
      <% component.with_trigger_btn do %>
        <%= icon "ellipsis-horizontal" %>
      <% end %>
      <% component.with_dropdown_menu do %>
				<%= render MenuComponent.new do |menu| %>
					<% menu.with_item do %>
						<%= button_to "Supprimer", medium, method: :delete, class: "block px-4 py-2 text-sm text-gray-700 cursor-pointer" %>
					<% end %>
				<% end %>
      <% end %>
    <% end %>
  </div>
  <div class="flex-1 my-3">
    <% if medium.file.representable? %>
      <%= image_tag medium.file.representation(resize_to_limit: [100, 100]), alt: medium.file.filename, class: "m-auto" %>
    <% else %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto my-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
    <% end %>
  </div>
</div>