<%# Locals: activity %>
<%
	selected_ids = Array(params[:selected_ids]).map(&:to_i)
%>

<%# Media Grid %>
<%= turbo_frame_tag :media_list, class: "media-grid", data: {dropzone_target: "list"} do %>
	<% @media.each do |medium| %>
		<%= render partial: "media/medium",
							 locals: { medium: medium, selected: selected_ids.include?(medium.id) } %>
	<% end %>
<% end %>