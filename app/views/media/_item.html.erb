<div class="flex flex-1 space-x-6 items-center min-w-0">
  <div class="flex-shrink-0 block">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
    </svg>
  </div>
  <div class="flex-1 min-w-0">
    <p class="overflow-hidden m-0 text-sm font-medium text-ellipsis">
      <%= link_to medium.name  || medium.file.filename.to_s, url_for(medium.file) %>
    </p>
    <p class="text-xs font-light text-muted-foreground">
      <%= number_to_human_size medium.file.byte_size %> - <%= l medium.created_at, format: :short %>
    </p>
  </div>
  <div>
    <%= render DropdownComponent.new(variant: :ghost) do |component| %>
      <% component.with_trigger_btn do %>
        <%= icon "ellipsis-horizontal" %>
      <% end %>

      <% component.with_dropdown_menu do %>
        <%= render MenuComponent.new do |menu| %>
          <% if can? medium, :destroy? %>
            <%= menu.with_item(href: medium_path(medium), method: :delete) do %>
              <span>Supprimer</span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
