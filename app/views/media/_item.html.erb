<div class="tile">
  <div class="tile__icon">
    <%= icon "document" %>
  </div>
  <div class="tile__content">
    <p><%= link_to medium.name  || medium.file.filename.to_s, url_for(medium.file) %></p>
    <p><%= medium.description %></p>
  </div>
  <div class="tile__action">
    <%= render DropdownComponent.new(variant: :ghost) do |component| %>
      <% component.with_trigger_btn do %>
        <%= icon "ellipsis-horizontal" %>
      <% end %>

      <% component.with_dropdown_menu do %>
        <ul class="py-1" role="none">
        </ul>
      <% end %>
    <% end %>
  </div>
</div>