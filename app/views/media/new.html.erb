<%= turbo_frame_tag :remote_modal do %>
  <dialog data-controller="remote-modal" class="backdrop:bg-background/80 backdrop:backdrop-blur-sm w-full md:max-w-[600px] lg:min-w-[900px] max-w-2xl border bg-background shadow-lg duration-200 rounded-md">
    <%= form_with model: @medium, method: :post, multipart: true,
                  class: "p-8",
                  builder: TailwindFormBuilder do |f| %>
      <% if @medium.errors.any? %>
        <div id="error_explanation">
          <h2><%= pluralize(@medium.errors.count, "error") %> prohibited this medium from being saved:</h2>

          <ul>
            <% @medium.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <div class="flex flex-col items-center justify-center gap-2 rounded-radius border border-dashed p-8 text-on-surface dark:border-outline-dark dark:text-on-surface-dark"
             data-controller="dropzone"
             data-dropzone-dragging-classes-value="bg-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
            class="w-12 h-12 opacity-75"
          >
            <path
              fill-rule="evenodd"
              d="M10.5 3.75a6 6 0 0 0-5.98 6.496A5.25 5.25 0 0 0 6.75 20.25H18a4.5 4.5 0 0 0 2.206-8.423 3.75 3.75 0 0 0-4.133-4.303A6.001 6.001 0 0 0 10.5 3.75Zm2.03 5.47a.75.75 0 0 0-1.06 0l-3 3a.75.75 0 1 0 1.06 1.06l1.72-1.72v4.94a.75.75 0 0 0 1.5 0v-4.94l1.72 1.72a.75.75 0 1 0 1.06-1.06l-3-3Z"
              clip-rule="evenodd"
              />
          </svg>
          <div class="group">
            <label
              for="fileInputDragDrop"
              class="font-medium text-primary group-focus-within:underline dark:text-primary-dark"
            >
              <%= f.file_field :file, class: "sr-only", data: {dropzone_target: "input"} %>
              Chercher
            </label>
            ou glisser-déposer vos fichiers
          </div>
          <small id="validFileFormats">PNG, JPG, WebP, PDF - Max 3MB</small>

        </div>
      </div>
      <%= f.submit "envoyer" %>
    <% end %>
  </dialog>
<% end %>