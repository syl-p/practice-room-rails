<section class="page">
  <header class="page-hero hero hero--sm u-bg-gray">
    <div class="hero__body container grid-xl">
      <h1>Practice room</h1>
      <p class="text-muted">La plateforme pour pratiquer vos passions avec vos potes !</p>
    </div>
  </header>
  <section class="container grid-xl">
    <div class="u-d-flex u-gap-3">
        <%= link_to new_practices_path, class: "empty" do %>
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </div>
          <p class="empty-title">
            Créer une nouvelle pratique
          </p>
        <% end %>
      <% @practices.each do |practice| %>
          <%= render practice %>
      <% end %>
    </div>
  </section>
</section>
