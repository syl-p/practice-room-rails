<% content_for :title, "Practice Room — Le carnet de pratique des musiciens" %>
<% content_for :description, "Practice Room est le carnet de pratique des musiciens : notez vos séances, suivez vos progrès, partagez vos exercices. Gratuit, open source, prêt à forker pour votre communauté." %>

<% if authenticated? %>

  <%# Hero accueil connecté — cohérent avec le hero marketing %>
  <section class="bg-primary text-primary-foreground pt-32 pb-12 px-4">
    <div class="container mx-auto">
      <span class="inline-block mb-4 rounded-full bg-primary-foreground/10 px-4 py-1.5 text-sm font-medium backdrop-blur">
        Bon retour parmi nous
      </span>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-3 leading-tight">
        On reprend ?
      </h1>
      <p class="text-lg text-primary-foreground/80 max-w-xl">
        Vos pratiques vous attendent. Sélectionnez-en une pour reprendre exactement là où vous en étiez.
      </p>
    </div>
  </section>

  <%# Liste des pratiques %>
  <section class="py-10 px-4">
    <div class="container mx-auto">
      <div class="flex items-end justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold tracking-tight">Vos pratiques</h2>
          <p class="text-sm text-muted-foreground mt-1">
            <%= @practices.size %> pratique<%= "s" if @practices.size > 1 %> en cours
          </p>
        </div>
      </div>
      <div class="space-y-6 lg:flex lg:space-x-6 lg:space-y-0 lg:items-stretch lg:flex-nowrap lg:overflow-hidden lg:overflow-x-auto lg:is-overflow-x-scroll lg:w-full">
        <%= link_to new_practices_path, class: "min-w-[300px] flex flex-col justify-center items-center rounded-xl border-2 border-dashed border-border hover:border-primary/40 hover:bg-secondary/50 p-8 transition-colors" do %>
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </div>
          <span class="font-medium text-muted-foreground text-center">
            Nouvelle pratique
          </span>
        <% end %>
        <% @practices.each do |practice| %>
          <%= render practice %>
        <% end %>
      </div>
    </div>
  </section>

<% else %>

  <%# ===== LANDING PAGE POUR LES VISITEURS ===== %>

  <%# Hero — fond primary, focus musique %>
  <section class="bg-primary text-primary-foreground pt-32 pb-20 px-4">
    <div class="container mx-auto text-center max-w-4xl">
      <span class="inline-block mb-6 rounded-full bg-primary-foreground/10 px-4 py-1.5 text-sm font-medium backdrop-blur">
        Gratuit, open source, fait pour la musique
      </span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6 leading-tight">
        Votre musique mérite<br>un vrai carnet de pratique
      </h1>
      <p class="text-lg md:text-xl text-primary-foreground/80 mb-6 max-w-2xl mx-auto leading-relaxed">
        Practice Room, c'est l'endroit où vous notez ce que vous avez joué,
        vous suivez vos progrès et vous partagez vos exercices avec
        d'autres musiciens — sans prise de tête.
      </p>
      <p class="text-sm text-primary-foreground/60 mb-10 max-w-xl mx-auto">
        Guitare, piano, chant, batterie, violon, basse, MAO… peu importe
        l'instrument&nbsp;: on compte toutes les pratiques.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <%= ui_action_to "Créer mon compte", new_registration_path, as: :link, variant: :secondary, class: "text-base h-12 px-8 hero-cta", data: { turbo: false } %>
        <%= ui_action_to "Voir ce que ça donne", "#screenshots", as: :link, variant: :primary, class: "text-base h-12 px-8 bg-transparent border border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10" %>
      </div>
    </div>
  </section>

  <%# Screenshots — espace réservé, à compléter %>
  <section id="screenshots" class="py-20 px-4 bg-white dark:bg-background">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <span class="inline-block mb-3 text-sm font-semibold text-primary uppercase tracking-wider">On vous montre ?</span>
        <h2 class="h2 text-3xl md:text-4xl mb-4">Ça ressemble à quoi, concrètement ?</h2>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Quelques extraits de l'application pour voir avant de créer un compte.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
          <%= render partial: "shared/screenshot_placeholder", locals: {
            title: "1. L'espace de pratique",
            description: "La liste des pratiques d'un musicien : sélection d'activités, date picker de la semaine avec la série de jours, et gros bouton rond « Pratiquer »."
          } %>
        </div>
        <div>
          <%= render partial: "shared/screenshot_placeholder", locals: {
            title: "2. Une séance en cours",
            description: "Vue mobile du minuteur : activité en haut, temps restant en grand, mise en pause et fin de séance."
          } %>
        </div>
        <div class="lg:col-span-3">
          <%= render partial: "shared/screenshot_placeholder", locals: {
            title: "3. La progression",
            description: "Vue desktop des stats : donuts par type de pratique, série de jours en cours et temps cumulé par activité."
          } %>
        </div>
      </div>
    </div>
  </section>

  <%# Fonctionnalités — focus musicien %>
  <section class="py-20 px-4 bg-secondary/50">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <span class="inline-block mb-3 text-sm font-semibold text-primary uppercase tracking-wider">Ce qu'on met entre vos mains</span>
        <h2 class="h2 text-3xl md:text-4xl mb-4">Tout ce qu'il faut, rien de trop</h2>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Pas de menus à rallonge. Juste ce qu'il faut pour pratiquer,
          noter, et repartir.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "musical-note", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Votre journal de pratique</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Notez ce que vous avez joué : exercices, morceaux, minutes par jour.
            Vos statistiques s'accumulent sans effort.
          </p>
        </article>

        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "users", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Une communauté de musiciens</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Échangez vos gammes, vos covers et vos astuces. Empruntez
            les exercices des autres, partagez les vôtres.
          </p>
        </article>

        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "flag", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Des objectifs qui vous ressemblent</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Travailler ce passage, finir ce morceau, enchaîner vos gammes.
            Vous suivez votre objectif semaine après semaine.
          </p>
        </article>

        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "paper-clip", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Partitions, MP3, vidéos</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Attachez vos fichiers à vos exercices : partitions PDF,
            vidéos de démo, enregistrements. Tout à portée de main.
          </p>
        </article>

        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "chart-bar", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Des stats qui donnent envie</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Minutes jouées, régularité, série de jours. Vous voyez où vous
            en êtes, et ça donne envie de continuer.
          </p>
        </article>

        <article class="group rounded-xl border bg-card p-6 transition-shadow hover:shadow-md">
          <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/15 transition-colors">
            <%= icon "code-bracket", class: "w-5 h-5 text-primary" %>
          </div>
          <h3 class="font-bold text-lg mb-2">Pour tout le monde, grâce à l'open source</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Le projet est libre. <a href="https://github.com/syl-p/practice-room-rails" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">Forkez-le</a>
            pour votre propre communauté — course, danse, dessin — et partez de quelque chose de solide.
          </p>
        </article>
      </div>
    </div>
  </section>

  <%# Comment ça marche — en trois étapes %>
  <section class="py-20 px-4">
    <div class="container mx-auto max-w-5xl">
      <div class="text-center mb-16">
        <span class="inline-block mb-3 text-sm font-semibold text-primary uppercase tracking-wider">C'est facile</span>
        <h2 class="h2 text-3xl md:text-4xl mb-4">Trois étapes et vous jouez</h2>
        <p class="text-muted-foreground text-lg">
          De zéro à votre première séance notée en deux minutes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="text-center md:text-left">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary text-primary-foreground font-bold text-lg mb-4">
            1
          </div>
          <h3 class="font-bold text-lg mb-2">Créez votre compte</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Deux secondes chrono. Choisissez votre pseudo, dites-nous
            votre instrument, et c'est parti.
          </p>
        </div>

        <div class="text-center md:text-left">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary text-primary-foreground font-bold text-lg mb-4">
            2
          </div>
          <h3 class="font-bold text-lg mb-2">Ajoutez vos exercices</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Gammes, morceaux, technique. Créez les vôtres ou piochez
            dans la communauté, puis ajoutez vos partitions et objectifs.
          </p>
        </div>

        <div class="text-center md:text-left">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary text-primary-foreground font-bold text-lg mb-4">
            3
          </div>
          <h3 class="font-bold text-lg mb-2">Pratiquez, notez, reprenez</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Lancez le minuteur, notez vos séances, regardez votre série
            grimper. On s'occupe de la motivation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# Open source — une base pour d'autres communautés %>
  <section class="py-20 px-4 bg-secondary/50">
    <div class="container mx-auto max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-2">
          <span class="inline-block mb-3 text-sm font-semibold text-primary uppercase tracking-wider">Open source</span>
          <h2 class="text-2xl font-bold tracking-tight mb-0">Pas seulement pour la musique</h2>
        </div>
        <div class="lg:col-span-3 space-y-4">
          <p class="text-muted-foreground leading-relaxed">
            Practice Room est pensé pour les musiciens, mais il n'appartient
            à personne. Le cœur du projet — <strong class="text-foreground">suivre, partager, progresser</strong>
            — fonctionne pour le sport, la danse, le dessin, le chant…
            <strong class="text-foreground">Forkez le code, créez votre communauté</strong>,
            et vous partez de quelque chose de solide.
          </p>
          <ul class="space-y-2 text-sm text-muted-foreground">
            <li class="flex items-center gap-2">
              <%= icon "check", class: "size-4 text-primary" %>
              Exercices, historique, objectifs et commentaires inclus
            </li>
            <li class="flex items-center gap-2">
              <%= icon "check", class: "size-4 text-primary" %>
              Fichiers, statistiques et notifications déjà en place
            </li>
            <li class="flex items-center gap-2">
              <%= icon "check", class: "size-4 text-primary" %>
              Une base Rails solide, prête à évoluer avec vos besoins
            </li>
          </ul>
          <div class="pt-2 flex flex-col sm:flex-row gap-4">
            <%= ui_action_to "Voir le code sur GitHub", "https://github.com/syl-p/practice-room-rails", as: :link, variant: :primary, class: "h-11", data: { turbo: false } %>
            <%= ui_action_to "Rejoindre le Discord", "https://discord.gg/8vCbhQUK7M", as: :link, variant: :outline, class: "h-11", data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# CTA final — fond primary %>
  <section class="py-20 px-4 bg-primary text-primary-foreground">
    <div class="container mx-auto text-center max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">Votre prochaine séance mérite d'être suivie</h2>
      <p class="text-primary-foreground/80 text-lg mb-8">
        Gratuit, open source, zéro friction. Créez votre compte et
        notez votre première séance ce soir.
      </p>
      <%= ui_action_to "Créer mon compte", new_registration_path, as: :link, variant: :secondary, class: "text-base h-12 px-8 hero-cta", data: { turbo: false } %>
    </div>
  </section>

<% end %>