<section>
  <header class="hero bg-primary">
    <div class="hero-body container grid-xl">
      <h1>Practice room</h1>
      <p class="text-muted">La plateforme pour pratiquer vos passions avec vos potes !</p>
    </div>
  </header>
  <% if authenticated? %>
    <h2 class="text-primary mb-6 text-3xl">Reprenons là où nous en étions</h2>
    <div class="space-y-6 lg:flex lg:space-x-6 lg:space-y-0 lg:items-stretch lg:flex-nowrap lg:overflow-hidden lg:overflow-x-auto lg:is-overflow-x-scroll lg:w-full">
        <%= link_to new_practices_path, class: "min-w-[300px] flex flex-col justify-center items-center rounded-md border border-dashed bg-primary-foreground hover:bg-secondary p-6" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span className="text-body font-body text-neutral-400 text-center mt-3">
            Créer une nouvelle pratique
          </span>
        <% end %>
      <% @practices.each do |practice| %>
          <%= render practice %>
      <% end %>
    </div>
  <% end %>
</section>
