<% content_for :title, "Contact - Practice Room" %>
<parameter=content_for :description, "Contactez l'équipe de Practice Room pour toute question, suggestion ou signalement de bug." %>

<section class="pt-32 pb-20 px-4">
  <div class="container mx-auto max-w-xl text-center">
    <h1 class="h1 text-4xl mb-4">Contact</h1>
    <p class="text-muted-foreground text-lg mb-8">
      Une question, une suggestion ou un bug à signaler ? N'hésitez pas à nous écrire.
    </p>
    <div class="rounded-lg border bg-card p-8 text-left">
      <p class="text-muted-foreground text-center">
        Le formulaire de contact arrive bientôt.
        En attendant, rejoignez-nous sur
        <a href="https://discord.gg/8vCbhQUK7M" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">Discord</a>.
      </p>
    </div>
  </div>
</section>
