<article class="container mx-auto mt-10">
  <%= ui_action_to practice_path(@practice), as: :link, variant: :ghost, class: "flex space-x-2" do %>
    <%= icon "chevron-left" %>
    <span class="block">Retour à ma pratique</span>
  <% end %>

  <header class="rounded bg-background shadow p-4 mt-6 flex space-x-3 items-center" style="view-transition-name:activity-<%= @activity.id %>">
    <%= render partial: "practices/practice_entries/add",
               locals: {practice_id: session[:current_practice_id], activity_id: @activity.id} %>
    <div class="flex-1">
      <h2 class="font-bold">
        <%= @activity.title %>
      </h2>
      <p class="ftext-sm text-muted-foreground mb-3">
        Posté par <%= link_to @activity.user.username, @activity.user, data: { turbo_frame: "_top" } %>, le <time datetime="<%= @activity.created_at %>"><%= @activity.created_at %></time>
      </p>
      <% @activity.tags.each do |tag| %>
        <%= render(TagComponent.new(tag.name, variant: :outline)) %>
      <% end %>
    </div>
    <%= render partial: "practices/activities/dropdown", locals: {practice: @practice, activity: @activity} %>
  </header>
  <div class="my-10 lg:grid lg:grid-cols-6 gap-4">
    <article class="mb-6 lg:mb-0 lg:col-span-4">
      <%= @activity.content %>
    </article>
    <aside class="lg:col-span-2">
      <%= render partial: "practices/activities/media", locals: {media: @activity.media} %>
    </aside>
  </div>
  <div class="w-full flex justify-center">
    <div class="shrink-0 bg-border h-[1px] w-full my-4"></div>
  </div>
  <footer>
    <h2 class="text-xl mb-3">
      Discussions
    </h2>

    <%= turbo_frame_tag record_id_gen(@activity, Comment.new) do %>
      <%= render partial: "comments/form", locals: {comment: Comment.new, commentable: @activity} if authenticated? %>
    <% end %>

    <%= turbo_frame_tag "#{dom_id(@activity)}_comments" do %>
      <%= render partial: "comments/comment", collection: @activity.comments, as: :comment %>
    <% end %>
  </footer>
</article>
