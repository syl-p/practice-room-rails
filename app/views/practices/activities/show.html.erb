<article class="container grid-xl">
  <%= link_to practice_path(@practice), class: "u-d-block u-mb-2" do %>
    <span class="block">Retour à ma pratique</span>
  <% end %>

  <%= render partial: "practices/activities/card",
             locals: {tag_container: :header, practice: @practice, activity: @activity} %>

  <div class="divider text-center" data-content="CONTENU"></div>

  <div class="columns">
    <article class="column col-8 col-lg-12">
      <%= @activity.content %>
    </article>
    <aside class="column col-4 col-lg-12">
      <%= render partial: "practices/activities/media", locals: {media: @activity.media} %>
    </aside>
  </div>

  <div class="divider text-center" data-content="DISCUSSIONS"></div>

  <footer>
    <%= turbo_frame_tag record_id_gen(@activity, Comment.new) do %>
      <%= render partial: "comments/form", locals: {comment: Comment.new, commentable: @activity} if authenticated? %>
    <% end %>

    <%= turbo_frame_tag "#{dom_id(@activity)}_comments" do %>
      <%= render partial: "comments/comment", collection: @activity.comments, as: :comment %>
    <% end %>
  </footer>
</article>
