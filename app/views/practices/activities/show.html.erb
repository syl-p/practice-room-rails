<article class="container mx-auto max-w-5xl">
    <header class="mb-4 flex items-center justify-between gap-2">
        <%= render partial: "practices/back_to_practice_link" %>
        <%= render partial: "practices/activities/dropdown", locals: {practice: @practice, activity: @activity, practice_activity: @practice_activity} %>
    </header>

    <%= render partial: "practices/activities/card", locals: {tag: :header, practice: @practice, activity: @activity } %>

    <section class="mt-6 lg:grid lg:grid-cols-6 gap-6">
      <article class="lg:col-span-4">
        <%= render TabsComponent.new do |component| %>
          <% component.with_tab(id: "content", label: "Description") do %>
            <div class="max-w-prose">
              <%= @activity.content %>
            </div>
          <% end %>

          <% if @activity.media.any? %>
            <% component.with_tab(id: "media", label: "Médias") do %>
              <%= render partial: "practices/activities/media", locals: {media: @activity.media} %>
            <% end %>
          <% end %>


          <% component.with_tab(id: "goal", label: "Objectif", button_class: "block lg:hidden") do %>
            <% if @practice_activity.goals.present? %>
              <!-- Mettre à jour les progrès -->
              <%= turbo_frame_tag :goal_tab, src: goal_path(id: @practice_activity.goals.first.id), loading: :lazy do %>
                ...
              <% end %>
            <% else %>
              <!-- Proposer de définir un objectif -->
              <%= turbo_frame_tag :goal_tab, src: new_practice_activity_goal_path(practice_activity_id: @practice_activity.id), loading: :lazy do %>
                ...
              <% end %>
            <% end %>
          <% end %>

          <% component.with_tab(id: "comments", label: "Discussions") do %>
            <div class="space-y-6">
              <% if authenticated? %>
                <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
                  <%= turbo_frame_tag record_id_gen(@activity, Comment.new) do %>
                    <%= render partial: "comments/form", locals: {comment: Comment.new, commentable: @activity} %>
                  <% end %>
                </div>
              <% else %>
                <p class="rounded-xl border border-dashed border-border bg-secondary/40 p-4 text-sm text-muted-foreground">
                  <%= link_to "Connectez-vous", new_session_path, class: "font-medium text-primary hover:underline" %>
                  pour rejoindre la discussion.
                </p>
              <% end %>

              <div>
                <h3 class="mb-1 text-sm font-semibold text-foreground">
                  <%= pluralize(@activity.comments.count, "commentaire") %>
                </h3>

                <%= turbo_frame_tag "#{dom_id(@activity)}_comments", class: "divide-y divide-border" do %>
                  <%= render partial: "comments/comment", collection: @activity.comments, as: :comment %>

                  <div class="comments-empty hidden flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-border bg-secondary/40 py-10 text-center">
                    <%= icon "chat-bubble-left-ellipsis", class: "size-6 text-muted-foreground" %>
                    <div>
                      <p class="text-sm font-medium text-foreground">Aucune discussion pour l'instant</p>
                      <p class="mt-1 text-xs text-muted-foreground">
                        Lancez le bal &nbsp;—&nbsp; mentionnez un musicien avec <span class="font-medium text-primary">@pseudo</span>.
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </article>
      <aside class="hidden lg:block lg:col-span-2">
        <div class="rounded-xl border border-border bg-background p-5 shadow-sm lg:sticky lg:top-24">
          <% if @practice_activity.goals.present? %>
            <!-- Mettre à jour les progrès -->
            <%= turbo_frame_tag :goal_sidebar, src: goal_path(id: @practice_activity.goals.first.id), loading: :lazy do %>
              ...
            <% end %>
          <% else %>
            <!-- Proposer de définir un objectif -->
            <%= turbo_frame_tag :goal_sidebar, src: new_practice_activity_goal_path(practice_activity_id: @practice_activity.id), loading: :lazy do %>
              ...
            <% end %>
          <% end %>
        </div>
      </aside>
    </section>
</article>