<% if activities.any? %>
	<%= render partial: "practices/activities/card",
								collection: activities, as: :activity,
								locals: {practice: practice, classes: 'mb-3'} %>
	<footer class="mt-4">
			<%= ui_action_to onboarding_activities_new_path(),
											 as: :link, variant: :outline,
											 class: "w-full border-dashed bg-background", data: {turbo_frame: :remote_modal} do %>
			<%= icon "plus", class: "size-4" %>
			<span class="block">Ajouter une activité</span>
			<% end %>
	</footer>
<% else %>
	<%= render partial: "practices/activities/empty_state" %>
<% end %>