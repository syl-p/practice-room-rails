        Les ressources liées à cette activité.
    </p>
    <ul class="divide-y divide-border">
        <% media.each do |medium| %>
        <li class="p-4 hover:bg-muted">
            <%= render partial: "media/item", locals: { medium:} %>
        </li>
        <% end %>
    </ul>
<% end %>
