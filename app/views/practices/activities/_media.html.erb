<% if media.present? %>
    <p class="text-sm text-muted-foreground mb-3">
        Retrouvez ici les différentes ressources proposées par l'auteur.
    </p>
    <ul class="divide-y divide-gray-200">
        <% media.each do |medium| %>
        <li class="p-4 hover:bg-gray-50">
            <%= render partial: "media/item", locals: { medium:} %>
        </li>
        <% end %>
    </ul>
<% end %>
