<% if media.present? %>
  <div class="card">
    <div class="card__header">
      <h3 class="card__header-title u-mb-0">
        Media associés
      </h3>
      <p class="u-text-small u-mb-2 u-text-muted">
        Retrouvez ici les différentes ressources proposées par l'auteur.
      </p>
    </div>
    <div class="card__body">
        <% media.each do |medium| %>
          <%= render partial: "media/item", locals: { medium:} %>
        <% end %>
    </div>
  </div>
<% end %>