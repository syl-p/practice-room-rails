<article class="rounded bg-background shadow rounded p-6 mb-6 flex space-x-3 items-center"
         style="view-transition-name:activity-<%= activity.id %>">
  <div class="flex-1">
    <h3 class="font-bold">
      <%= link_to activity.title, practice_activity_path(practice, activity), data: { turbo_frame: "_top" } %>
    </h3>
    <p class="text-sm text-muted-foreground">
      Proposé par <%= link_to activity.user.username, activity.user, data: { turbo_frame: "_top" } %>
    </p>
  </div>
  <div>
    <% activity.tags.each do |tag| %>
      <%= render(TagComponent.new(tag.name, variant: :outline)) %>
    <% end %>
  </div>
  <div class="flex justify-between items-center">
    <% if authenticated? %>
      <%= render partial: "practices/practiced_activities/add", locals: {practice_id: @practice, activity_id: activity.id} %>
    <% end %>
  </div>
</article>
