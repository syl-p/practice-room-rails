<% tag = local_assigns.fetch("tag", :article) %>
<% extra_classes = local_assigns[:classes] %>
<%= turbo_frame_tag record_id_gen(practice, activity) do %>
  <%= content_tag tag, style: "view-transition-name:activity-#{activity.id}",
                  class: "group rounded-xl border border-border bg-background p-4 shadow-sm transition-all hover:border-primary/30 hover:shadow-md #{extra_classes}" do %>
    <div class="flex items-start gap-3 sm:gap-4">
      <div class="min-w-0 flex-1">
        <%= link_to practice_activity_path(practice, activity), data: { turbo_frame: "_top" }, class: "block" do %>
          <h3 class="h4 leading-snug group-hover:text-primary group-hover:underline group-hover:underline-offset-4"><%= activity.title %></h3>
        <% end %>

        <% if activity.content.present? %>
          <p class="mt-1.5 line-clamp-2 text-sm leading-5 text-muted-foreground">
            <%= activity.content.to_plain_text.truncate(160) %>
          </p>
        <% end %>

        <% if activity.tags.any? %>
          <div class="hidden mt-3 lg:flex flex-wrap gap-1.5">
            <% activity.tags.each do |tag| %>
              <%= render(TagComponent.new(tag.name, variant: :outline)) %>
            <% end %>
          </div>
        <% end %>

				<% practice_activity = practice.practice_activities.to_a.find {|pa| pa.activity_id == activity.id} %>
				<% goal = practice_activity.active_goal %>
				<% if goal&.last_progress %>
					<div class="mt-4">
						<div class="mb-1 flex items-center justify-between text-xs text-muted-foreground">
							<span>Objectif en cours</span>
							<span><%= goal.last_progress.value %> / <%= goal.target_value %> <%= goal.unit %></span>
						</div>
						<progress value="<%= goal.progress_pourcent %>" max="100" aria-label="Objectif en cours"
			                class="h-1.5 w-full overflow-hidden rounded-full bg-border accent-highlight"></progress>
					</div>
				<% end %>
      </div>

			<%= render partial: "practices/activities/timers", locals: {
				practice: practice,
				activity: activity,
			} %>
    </div>

  <% end %>
<% end %>