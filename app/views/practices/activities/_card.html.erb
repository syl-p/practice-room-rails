<% tag = local_assigns.fetch("tag", :article) %>
<%= turbo_frame_tag record_id_gen(practice, activity) do %>
  <%= content_tag tag, style: "view-transition-name:activity-#{activity.id}",
                  class: "rounded-lg bg-background border shadow p-4 mb-6" do %>
    <div class="sm:flex sm:space-x-3 sm:items-center">
      <div class="flex-1">
        <h3 class="font-bold">
          <%= link_to activity.title, practice_activity_path(practice, activity), data: { turbo_frame: "_top" } %>
        </h3>
        <p class="text-sm text-muted-foreground mb-3">
          <%= activity.content.to_plain_text.truncate(200) %>
        </p>
      </div>
      <%= render partial: "practices/practice_entries/add",
                 locals: {practice_id: practice.id, activity_id: activity.id} %>
    </div>
    <div class="hidden md:block">
      <% activity.tags.each do |tag| %>
        <%= render(TagComponent.new(tag.name, variant: :outline)) %>
      <% end %>
    </div>
  <% end %>
<% end %>
