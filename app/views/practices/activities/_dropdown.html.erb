<%= render DropdownComponent.new(variant: :outline) do |component| %>
  <% component.with_trigger_btn do %>
    <%= icon "ellipsis-horizontal" %>
  <% end %>

  <% component.with_dropdown_menu do %>
    <%= render MenuComponent.new() do |menu| %>
      <% if can? activity, :edit? %>
        <%= menu.with_item(href: onboarding_activity_step_path({ activity_id: activity.id, step: Onboarding::Activity::STEPS.first }), data: {turbo: true, turbo_frame: :remote_modal}) do %>
          Modifier
        <% end %>
      <% end %>

      <%= menu.with_item(href: practice_practice_activity_path(practice, activity), method: :delete) do %>
        Détacher
      <% end %>
    <% end %>
  <% end %>
<% end %>
