<%= form_with url: practice_activities_path(practice_id: practice.id, format: :turbo_stream),
              method: :get, data: {turbo: true} do |f| %>
  <div class="flex flex-wrap items-center gap-2">
    <% @practice.tags.each do |tag| %>
      <label class="cursor-pointer">
        <%= f.check_box :tag_ids, {
          multiple: true,
          class: "hidden peer",
          onchange: "this.form.requestSubmit();"
        },
        tag.id,
        false %>
        <span class="inline-flex items-center rounded-full border border-border bg-background px-3 py-1 text-sm font-medium text-muted-foreground shadow-sm transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground">
          <%= tag.name %>
        </span>
      </label>
    <% end %>
  </div>
<% end %>