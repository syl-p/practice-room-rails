<%
  total_duration = tags_with_duration.sum(&:duration)
%>
<div class="bg-background border rounded p-6">
  <h2 class="text-xl mb-3">Repartition de votre pratique par tags</h2>
  <ul>
    <% tags_with_duration.each do |tag| %>
      <li class="flex items-center">
      <span class="flex-1">
        <%= tag.name %>
      </span>
        <progress class="progress" value="<%= (tag.duration.to_f/total_duration) * 100 %>" max="100"></progress>
      </li>
    <% end %>
  </ul>
</div>