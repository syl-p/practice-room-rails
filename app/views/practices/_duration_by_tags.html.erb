<%
  total_duration = tags_with_duration.sum(&:duration)
%>
<div class="card">
  <div class="card__header">
    <h3>Repartition de votre pratique par tags</h3>
  </div>
  <div class="card__body">
    <ul>
      <% tags_with_duration.each do |tag| %>
        <li class="u-d-flex u-items-center u-gap-3">
          <span class="d-block u-w-50">
            <%= tag.name %>
          </span>
          <progress class="progress u-flex-1" value="<%= (tag.duration.to_f/total_duration) * 100 %>" max="100"></progress>
        </li>
      <% end %>
    </ul>
  </div>
</div>