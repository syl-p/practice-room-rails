<%
  total_duration = tags_with_duration.sum(&:duration)
%>
<div class="card flex-1">
  <div class="card-header">
    <h2>Repartition de votre pratique par tags</h2>
  </div>
  <div class="card-body">
    <ul>
      <% tags_with_duration.each do |tag| %>
        <li class="d-flex items-center gap-3">
          <span class="d-block">
            <%= tag.name %>
          </span>
          <progress class="progress flex-1" value="<%= (tag.duration.to_f/total_duration) * 100 %>" max="100"></progress>
        </li>
      <% end %>
    </ul>
  </div>
</div>