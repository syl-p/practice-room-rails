<%= render DropdownComponent.new(variant: :outline) do |component| %>
  <% component.with_trigger_btn do %>
    <% icon "ellipsis-horizontal" %>
  <% end %>

  <% component.with_dropdown_menu do %>
    <ul class="menu" role="none">
      <li class="menu__item"><%= link_to "Editer", edit_practice_path(id: practice.id)  %></li>
      <li class="menu__item"><%= button_to "Supprimer", practice_path(id: practice.id), method: :delete, class: "btn btn--link p-0"  %></li>
    </ul>
  <% end %>
<% end %>