<% if @practice_entry.persisted? %>
  <%= turbo_stream.replace "user_practices" do %>
    <%= render partial: "shared/user_practices" %>
  <% end %>

  <%= turbo_stream.append :practice_entries_list do %>
    <%= render partial: "practices/practice_entries/item", locals: {practice_entry: @practice_entry} %>
  <% end %>

  <%= turbo_stream.update :practice_entries_empty, "" %>
<% end %>

<%= turbo_flash_stream %>