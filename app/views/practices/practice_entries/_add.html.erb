<%= form_with url: practice_practice_entries_path(practice_id:, activity_id:),
              html: { id: "timer-#{activity_id}"},
              data: {turbo: true, controller: "btn-timer"} do |f| %>
  <%= f.hidden_field :duration, data: {btn_timer_target: "input"} %>
  <%= f.hidden_field :practice_id, value: "1", data: {btn_timer_target: "input"} %>

  <%= f.button class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(" "),
               data: {btn_timer_target: "button", action: "click->btn-timer#toggle"} do %>
    <span data-btn-timer-target="display" class="hidden"></span>
    <span data-btn-timer-target="label">Pratiquer</span>
  <% end %>

  <%= f.submit "Enregistrer", class: ["hidden", TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(" "),
               data: {btn_timer_target: "submitButton"} %>
<% end %>