<%= form_with url: practice_practice_entries_path(practice_id:, activity_id:),
              builder: TailwindFormBuilder,
              html: { id: "timer-#{activity_id}"},
              data: {turbo: true,  "turbo-permanent": true,
                     controller: "btn-timer",
                     btn_timer_play_label_value: "Pratiquer",
                     btn_timer_pause_label_value: "Faire une pause",
                     btn_timer_activity_id_value: activity_id,
              } do |f| %>
  <%= f.hidden_field :duration, data: {btn_timer_target: "input"} %>
  <%= f.hidden_field :practice_id, value: "1", data: {btn_timer_target: "input"} %>

  <%= render BtnGroupComponent.new do %>
    <span class="<%= tw_merge(TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::SECONDARY_CLASSES) %>">
      <%= icon "clock" %>
      <span  data-btn-timer-target="display">
        --:--
      </span>
    </span>

    <%= ui_action_to as: :button, variant: :primary,
                 data: {btn_timer_target: "toggleBtn", action: "click->btn-timer#toggle"} do %>
      Pratiquer
    <% end %>
  <% end %>

  <%= f.submit "Terminer", class: "hidden",
               data: {btn_timer_target: "submitButton"} %>
<% end %>