<%= turbo_stream.remove dom_id(@practice_entry) %>

<%= turbo_stream.replace "user_practices" do %>
  <%= render partial: "shared/user_practices" %>
<% end %>

<%= turbo_stream.replace :date_picker do %>
	<%= render DayPickerComponent.new(practice: @practice, current_date: Date.today) %>
<% end %>

<% if @remaining_for_day.zero? %>
  <%= turbo_stream.update :practice_entries_empty do %>
    <%= render partial: "practices/practice_entries/empty_state" %>
  <% end %>
<% end %>

<%= turbo_flash_stream %>