<%= turbo_frame_tag dom_id(practice_entry) do %>
  <div class="rounded-lg border bg-secondary text-card-foreground shadow-sm p-4 mb-3">
    <div class="flex-1 flex items-center">
      <div class="flex-1">
        <p class="text-xs text-muted-foreground">
          <%= display_time(practice_entry.duration) %> à <%= practice_entry.created_at %></p>
        <p>
          <%= link_to practice_entry.activity.title, practice_activity_path(practice_id: @practice.id, id: practice_entry.activity.id),
                      class: "block font-semibold truncate", data: {turbo: false} %>
        </p>
      </div>
      <div>
        <%= ui_action_to practice_practice_entry_path(
                           practice_id: @practice.id,
                           id: practice_entry.id
                         ),
                         as: :button,
                         method: :delete,
                         variant: :ghost do %>
          <%= icon "x-mark" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>