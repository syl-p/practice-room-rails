<%= turbo_frame_tag :practice_entries do %>
  <nav>
    <ul class="flex flex-wrap space-x-3 items-center justify-center mb-8">
      <% (@start_at..@end_at).each do |wd| %>
        <li>
          <%= link_to practice_practice_entries_path(practice_id: @practice.id, date: wd),
                      class: "block text-center p-2 rounded-full border relative #{'shadow-lg bg-primary text-white' if wd == @current_date}" do %>
            <span class="block"><%= wd.day %></span>
            <span class="block text-sm"><%= I18n.l(wd, format: "%b") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= turbo_frame_tag :practice_entries_list do %>
    <% @practice_entries.each do |practice_entry| %>
      <%= render partial: "practices/practice_entries/item", locals: {practice_entry:} %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag :practice_entries_empty do %>
    <%= render partial: "practices/practice_entries/empty_state" if @practice_entries.empty? %>
  <% end %>
<% end %>
