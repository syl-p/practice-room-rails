<article id="<%= dom_id practice %>" class="w-[300px] rounded-lg bg-secondary p-4 flex flex-col justify-between">
  <div class="flex space-x-3 mb-6">
		<div class="flex-1">
			<%= link_to practice.name, practice, class: "text-xl font-bold block flex-1", data: { turbo_frame: "_top" } %>
		</div>
    <%= render partial: "practices/dropdown", locals: {practice: } %>
  </div>
	<%= practice.description %><br>
	<p class="mb-6">Aujourd'hui: <%= display_time(practice.duration) %></p>

	<%= ui_action_to "Pratiquer", practice, as: :link %>
</article>
