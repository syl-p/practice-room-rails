<%
  total_duration = tags_with_duration.sum(&:duration)
%>

<div class="bg-background border rounded p-6 w-full">
  <h2 class="h2 mb-3">Repartition de votre pratique par tags</h2>
  <ul>
    <% tags_with_duration.each do |tag| %>
      <li class="flex items-center">
        <span class="w-1/2">
          <%= tag.name %>
        </span>
        <progress class="progress" value="<%= (tag.duration.to_f/total_duration) * 100 %>" max="100"></progress>
      </li>
    <% end %>
  </ul>
</div>
