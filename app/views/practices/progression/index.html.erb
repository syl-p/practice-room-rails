<section class="container mx-auto">
  <header class="mb-6">
    <%= render partial: "practices/back_to_practice_link" %>
		<div class="mt-6">
			<h2 class="h2">
				Statistiques pour votre pratique <%= @practice.name %>
			</h2>
			<p class="text-sm text-muted-foreground">
				Calculé à partir du temps total enregistré pour chaque activité.
			</p>
		</div>
  </header>

	<div class="space-y-6 lg:flex lg:justify-between lg:space-y-0 lg:space-x-6 mb-6">
		<%= render partial: "practices/progression/duration_by_tags", locals: {tags_with_duration: @stats[:tags_with_duration]} %>
		<%= render partial: "practices/progression/top_activities", locals: {top_practiced_activities: @stats[:top_practiced_activities]} %>
	</div>
</section>