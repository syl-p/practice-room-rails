<article class="rounded-lg bg-blue-100">
  <header class="p-3 container mx-auto">
    <div class="mb-3">
      <% practice.tags.each do |tag| %>
        <%= render(TagComponent.new(tag.name, variant: :outline)) %>
      <% end %>
    </div>
    <h2 class="text-2xl font-bold"><%= link_to practice.name, practice, data: { turbo_frame: "_top" } %></h2>
    <p class="font-light text-sm text-muted-foreground mb-3">
      Créée le <time datetime="<%= practice.created_at %>"><%= practice.created_at %></time>
    </p>
  </header>
  <aside class="flex justify-between items-center p-3 mt-3 container mx-auto">
    <%= link_to "Pratiquer", practice, class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(' ') %>
  </aside>
</article>
