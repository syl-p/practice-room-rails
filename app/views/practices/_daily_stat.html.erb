<%
  radius = 30
  stroke = 5
  normalized_radius = radius - stroke / 2.0
  circumference = normalized_radius * 2 * Math::PI
  progress = (state > goal ? goal : state) * 100 / goal
  stroke_dash_offset = circumference - (progress / 100.0) * circumference
  color_classes = progress < 100 ? 'text-blue-700' : 'text-green-500'
%>

<div>
  <svg viewBox="0 0 80 80">
    <!-- Background circle -->
    <circle
      r="<%= normalized_radius %>"
      cx="40"
      cy="40"
      stroke-width="<%= stroke %>"
      stroke="lightgray"
      fill="transparent"
      />
    <!-- Progress circle -->
    <circle
      class="<%= color_classes %>"
      r="<%= normalized_radius %>"
      cx="40"
      cy="40"
      stroke-width="<%= stroke %>"
      stroke-dasharray="<%= circumference %>"
      stroke-dashoffset="<%= stroke_dash_offset %>"
      stroke-linecap="round"
      stroke="currentColor"
      fill="transparent"
      transform="rotate(-90 40 40)"
      />
  </svg>
  <p class="absolute text-blue-700 text-xs font-semibold">
    <%= "#{progress}%" %>
  </p>
</div>
<div>
  <p class="font-bold text-sm mb-1"><%= label_title %></p>
  <p class="text-xs"><%= label_subtitle %></p>
</div>
