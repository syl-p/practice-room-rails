<% content_for :title, "Vos pratiques" %>

<section class="container pt-20">
  <header class="mb-10">
    <h1 class="text-4xl font-bold uppercase">
      Bonjour, qu'allons nous travailler ?
    </h1>
  </header>
  <ul class="grid grid-cols-12 gap-6">
    <li class="mb-3 col-span-4">
      <%= link_to new_practices_path, class: "flex flex-col justify-center items-center rounded-md border border-dashed bg-primary-foreground hover:bg-secondary p-6" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span className="text-body font-body text-neutral-400 text-center mt-3">
          Crééer une nouvelle pratique
        </span>
      <% end %>
    </li>
    <% @practices.each do |practice| %>
      <li class="mb-3 col-span-4">
        <%= render practice %>
      </li>
    <% end %>
  </ul>
</section>