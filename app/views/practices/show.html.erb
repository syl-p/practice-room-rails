<main class="page">
  <header class="hero hero-sm page-hero bg-gray">
    <div class="hero-body container grid-xl">
      <div class="d-flex">
        <div class="flex-1">
          <h1 class="mb-0 h1">
            Aujourd'hui, votre pratique <br>
            <span class="text-primary"><%= @practice.name %></span>
          </h1>
          <p class="text-muted"><%= @practice.description %></p>
        </div>
        <div>
          <%= render partial: "practices/dropdown", locals: {practice: @practice} %>
        </div>
      </div>

      <div class="d-flex gap-3 d-sm-flex-col">
        <%= render partial: "practices/duration_by_tags", locals: {tags_with_duration: @stats[:tags_with_duration]} %>
        <%= render partial: "practices/daily_stats" %>
      </div>
    </div>
  </header>

  <section class="container grid-xl">
      <article>
        <header class="heading">
          <div class="heading-content">
            <h2 class="m-0">
              Vos activités
              (<%= turbo_frame_tag :activities_count do %>
                <%= @practice.activities.count %>
              <% end %>)
            </h2>
            <p class="text-muted">Retrouvez les activités liées à votre pratique ici.</p>
          </div>
          <div class="heading-actions d-sm-hide">
            <%= render partial: "practices/activities/filters", locals: {practice: @practice} %>
          </div>
        </header>
        <%= turbo_frame_tag :activities do %>
          <% if @practice.activities.any? %>
            <%= render partial: "practices/activities/card",
                       collection: @practice.activities, as: :activity,
                       locals: {practice: @practice} %>
          <% else %>
            <%= render partial: "practices/activities/empty_state" %>
          <% end %>
        <% end %>
      </article>
      <div class="divider"></div>
      <aside>
        <h2>
          Journal de votre pratique
        </h2>
        <%= turbo_frame_tag :practice_entries,
                            src: practice_practice_entries_path(practice_id: @practice.id),
                            loading: :lazy do %>
          Chargement...
        <% end %>
      </aside>
  </section>
</main>