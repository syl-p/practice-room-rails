<section class="container mx-auto">
    <header class="mb-6">
      <%= render DayPickerComponent.new(practice: @practice, current_date: Date.today) %>
    </header>
    <article class="mb-6">
        <h2 class="flex-1 font-semibold tracking-tight mb-3">
            Vos objectifs du jour
        </h2>
        <div class="flex space-x-6 flex-nowrap overflow-hidden overflow-x-auto w-full">
            <%= render DonutStatComponent.new(
        state: @stats[:more_than_10_mn_today][:state],
        goal: @stats[:more_than_10_mn_today][:goal],
        label_title: '10 minutes',
        label_subtitle: 'Au moins 10 minutes de pratique'
      ) %>


      <%= render DonutStatComponent.new(
        state: @stats[:have_3_exercises_today][:state],
        goal: @stats[:have_3_exercises_today][:goal],
        label_title: '3 activitiés différentes',
        label_subtitle: 'Pratiquez au moins 3 activitités'
      ) %>
        </div>
    </article>
    <article data-controller="timer-manager">
        <header class="flex space-x-3 items-center mb-3">
            <h2 class="flex-1 font-semibold tracking-tight">
                Vos activités
                (<%= turbo_frame_tag :activities_count do %>
                    <%= @practice.activities.count %>
                <% end %>)
            </h2>
            <%= render partial: "practices/activities/filters", locals: {practice: @practice} %>
        </header>
        <%= turbo_frame_tag :activities, src: practice_activities_path(practice_id: @practice.id), loading: :lazy do %>
          ...
        <% end %>
    </article>
</section>