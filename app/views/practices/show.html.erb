<section class="container mx-auto max-w-4xl">
    <header class="mb-6">
      <%= render DayPickerComponent.new(practice: @practice, current_date: Date.today) %>
    </header>

    <article class="mb-8">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="h2">Objectifs du jour</h2>
        <span class="rounded-full border border-border bg-background px-2.5 py-0.5 text-xs font-medium text-muted-foreground shadow-sm">
          Aujourd'hui
        </span>
      </div>
      <%= render partial: "practices/daily_stats" %>
    </article>

    <article data-controller="timer-manager">
        <header class="mb-4 flex flex-wrap items-center gap-3">
            <h2 class="h2 flex-1 min-w-0">
                Activités
                (<%= turbo_frame_tag :activities_count do %>
                    <%= @practice.activities.count %>
                <% end %>)
            </h2>
            <%= render partial: "practices/activities/filters", locals: {practice: @practice} %>
        </header>

        <%= turbo_frame_tag :activities do %>
          <%= render partial: "practices/activities/list", locals: { activities: @practice.activities, practice: @practice } %>
        <% end %>
    </article>
</section>