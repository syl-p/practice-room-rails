<div id="dayli_stats" class="flex space-x-6 flex-nowrap overflow-hidden overflow-x-auto w-full">
	<%= render DonutStatComponent.new(
		state: @stats[:total_duration],
		goal: 10.minutes,
		label_title: "#{human_duration_short(@stats[:total_duration])} / 10 min",
		label_subtitle: 'Au moins 10 minutes de pratique'
	) %>

	<%= render DonutStatComponent.new(
		state: @stats[:activities_count],
		goal: 3,
		label_title: "#{@stats[:activities_count]} / 3 activités",
		label_subtitle: 'Pratiquez au moins 3 activités'
	) %>
</div>