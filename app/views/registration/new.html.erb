<section class="container pt-20">
  <h1 class="text-xl font-bold mb-3">Edition des informations</h1>
  <%= form_with model: @user, url: registration_path, builder: TailwindFormBuilder, data: {turbo: false} do |f| %>
    <fieldset class="border p-6 rounded-lg lg:col-span-4 mb-6">
      <legend>Informations générales</legend>
      <%= render partial: 'registration/avatar_uploader', locals: {f:} if @user.persisted? %>
      <%= f.text_field :username %>
      <%= f.email_field :email_address %>
      <%= f.text_area :bio %>
    </fieldset>
    <%= f.submit "S'inscrire" %>
  <% end %>
</section>