<header>
  <h2 class="mt-6 text-3xl font-extrabold text-gray-900">Créé ton compte pour nous rejoindre</h2>
  <p>Si tu en as déjà un, <%= link_to "connecte toi", new_session_path %>.</p>
</header>

<div class="mt-8">
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
  <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

  <%= form_with model: @user, url: registration_path, builder: TailwindFormBuilder, data: {turbo: false} do |f| %>
    <%= f.text_field :username, required: true, autofocus: true %>
    <%= f.email_field :email_address, required: true %>
    <%= f.submit "S'inscrire" %>
  <% end %>
</div>