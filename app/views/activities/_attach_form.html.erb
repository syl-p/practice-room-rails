<% if Current.user.cached_practices.any? %>
	<% current_practice_id = session[:current_practice_id] %>
	<%= render BtnGroupComponent.new do %>
		<%= ui_action_to "Ajouter à ma pratique", practice_practice_activities_path(practice_id: current_practice_id, activity_id: activity.id),
										as: :button, method: :post, data: {turbo_frame: "_top"} %>

		<%= render DropdownComponent.new(variant: :outline) do |component| %>
			<% component.with_trigger_btn do %>
				<% icon "chevron-down" %>
			<% end %>
			<% component.with_dropdown_menu do %>
				<%= render MenuComponent.new do |menu| %>
					<% Current.user.cached_practices.each do |practice| %>
						<% menu.with_item(href: practice_practice_activities_path(practice_id: practice.id, activity_id: activity.id)) do %>
							<%= practice.name %>
						<% end %>
					<% end %>
					<% menu.with_item(href: new_practices_path) do %>
						Créer une nouvelle pratique
					<% end %>
				<% end %>
			<% end %>
		<% end %>
	<% end %>
<% else %>
	<%= link_to "Créér une nouvelle pratique", new_practices_path,
												data: {turbo: false},
												class: "block px-4 py-2 text-sm text-foreground cursor-pointer" %>
<% end %>