<% current_practice_id = session[:current_practice_id] %>
  <%= form_with url: activity_attach_path(activity_id: activity.id),
                method: :post,
                builder: TailwindFormBuilder do |f| %>
    <%= f.select :practice_id, Current.user.cached_practices.map {|p| [p.name, p.id]}, selected: current_practice_id %>
    <%= f.submit "Attacher" %>
  <% end %>