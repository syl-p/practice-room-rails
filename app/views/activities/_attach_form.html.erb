<% current_practice_id = session[:current_practice_id] %>
<div class="btn__group">
  <%= button_to "Ajouter à ma pratique", practice_attach_activity_path(practice_id: current_practice_id, id: activity.id),
                method: :post, class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(" "),
  data: {turbo_frame: "_top"} %>
  <%= render DropdownComponent.new(variant: :outline) do |component| %>
    <% component.with_trigger_btn do %>
      <% icon "chevron-down" %>
    <% end %>
    <% component.with_dropdown_menu do %>
      <ul class="menu" role="none">
        <% Current.user.cached_practices.each do |practice| %>
          <li class="menu__item">
            <%= button_to practice.name, practice_attach_activity_path(practice_id: practice.id, id: activity.id),
                          method: :post, class: "btn btn--link" %></li>
        <% end %>
        <li class="menu__item">
          <%= link_to "Créér une nouvelle pratique", new_practices_path,
                      data: {turbo: false},
                      class: "btn btn--link" %>
        </li>
      </ul>
    <% end %>
  <% end %>
</div>