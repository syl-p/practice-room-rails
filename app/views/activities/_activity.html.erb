<article id="<%= dom_id activity %>" class="min-w-[300px] rounded-lg bg-secondary p-4 flex">
  <div class="flex-1 flex space-x-3 items-center mb-6">
    <%= link_to activity.title, activity, class: "text-xl font-bold block flex-1", data: { turbo_frame: "_top" } %>
  </div>
  <div class="flex space-x-3 items-center">
    <p class="flex-1">
    <%= link_to "Voir", activity, class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::PRIMARY_CLASSES].join(' ') %>
  </div>
</article>
