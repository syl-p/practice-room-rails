<section>
  <header class="bg-blue-100 py-20">
    <h1 class="text-2xl"><%= @activity.title %></h1>
    <%= render partial: "practiced_activities/add", locals: {activity_id: @activity.id} %>
  </header>
  <hr>

  <%= render partial: "comments/form", locals: {comment: Comment.new, commentable: @activity} %>
  <%= render partial: "comments/comment", collection: @activity.comments, as: :comment %>
</section>