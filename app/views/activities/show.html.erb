<section class="bg-blue-100">
  <header class="py-20">
    <div class="container">
      <div class="flex space-x-6">
        <div class="flex-1">
          <h1 class="text-2xl font-bold"><%= @activity.title %></h1>
          <p class="font-light text-sm text-muted-foreground">
            Posté par <%= link_to @activity.user.username, @activity.user %>, le <time datetime="<%= @activity.created_at %>"><%= @activity.created_at %></time>
          </p>
        </div>
        <%= render partial: "practiced_activities/add", locals: {activity_id: @activity.id} %>
      </div>
    </div>
  </header>
  <section class="rounded-t-3xl bg-white py-8">
    <div class=" container my-10 lg:grid lg:grid-cols-6 gap-4">
      <article class="mb-6 lg:mb-0 lg:col-span-4">
        <%= @activity.content %>
        <hr class="shrink-0 bg-border h-[1px] w-full my-4" />
        <% @activity.tags.each do |tag| %>
          <%= render(TagComponent.new(tag.name, variant: :primary)) %>
        <% end %>
      </article>
      <aside  class="lg:col-span-2">
        <h3 class="text-xl mb-3">
          Media associés
        </h3>
        <ul class="divide-y divide-gray-200">
          <% @activity.media.each do |medium| %>
            <li class="p-4 hover:bg-gray-50"><%= render partial: "media/item", locals: {medium:} %></li>
          <% end %>
        </ul>
      </aside>
    </div>

    <footer class="container">
      <h2 class="text-xl mb-3">
        Discussions
      </h2>
      <%= turbo_frame_tag record_id_gen(@activity, Comment.new) do %>
        <%= render partial: "comments/form", locals: {comment: Comment.new, commentable: @activity} if authenticated? %>
      <% end %>

      <%= turbo_frame_tag "#{dom_id(@activity)}_comments" do %>
        <%= render partial: "comments/comment", collection: @activity.comments, as: :comment %>
      <% end %>
    </footer>
  </section>
</section>