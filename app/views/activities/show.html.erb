<%= turbo_frame_tag :remote_modal do %>
  <dialog data-controller="remote-modal" class="backdrop:bg-background/80 backdrop:backdrop-blur-sm w-[calc(100%-1.5rem)] md:max-w-[600px] max-w-full max-h-[85dvh] overflow-y-auto gap-4 border bg-background shadow-lg duration-200 rounded-md">
    <div class="min-w-0 p-5 sm:p-6">
      <article class="space-y-5">
        <header class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary">
              Activité de la communauté
            </p>
            <h2 class="h2 mt-1 break-words">
              <%= link_to @activity.title, @activity, data: { turbo_frame: "_top" } %>
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Par
              <%= link_to @activity.user.username, @activity.user, data: { turbo_frame: "_top" }, class: "font-medium text-foreground hover:underline" %>
              · <%= time_ago_in_words(@activity.created_at) %>
            </p>
          </div>

          <% if authenticated? %>
            <div class="shrink-0">
              <%= render partial: "bookmarks/btn", locals: {activity_id: @activity.id} %>
            </div>
          <% end %>
        </header>

        <p class="text-sm leading-relaxed text-foreground/90"><%= @activity.content %></p>

        <% if @activity.media.any? %>
          <div>
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              Médias (<%= @activity.media.count %>)
            </h3>
            <ul class="flex flex-wrap gap-2">
              <% @activity.media.each do |medium| %>
                <li class="flex items-center gap-1.5 rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-medium text-muted-foreground">
                  <%= icon "paper-clip", class: "size-3.5 shrink-0" %>
                  <span class="truncate max-w-[16rem]"><%= medium.name || medium.file.filename.to_s %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @activity.tags.any? %>
          <div class="flex flex-wrap gap-2">
            <% @activity.tags.each do |tag| %>
              <%= render(TagComponent.new(tag.name, variant: :outline)) %>
            <% end %>
          </div>
        <% end %>

        <footer class="flex items-center justify-between gap-4 border-t border-border pt-4">
          <p class="text-sm text-muted-foreground">
            <%= icon "chat-bubble-left-right", class: "mr-1 inline-block size-4" %>
            <%= @activity.comments.count %> discussion<%= "s" unless @activity.comments.count == 1 %>
          </p>

          <% if authenticated? %>
            <%= render partial: "activities/attach_form", locals: {activity: @activity} %>
          <% end %>
        </footer>
      </article>
    </div>
  </dialog>
<% end %>