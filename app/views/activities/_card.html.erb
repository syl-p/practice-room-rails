<article class="rounded-lg bg-blue-100 <%= classes if local_assigns.has_key? :classes %>" style="view-transition-name:activity-<%= activity.id %>">
  <header class="border border-b p-3 container mx-auto">
    <div class="mb-3">
      <% activity.tags.each do |tag| %>
        <%= render(TagComponent.new(tag.name, variant: :outline)) %>
      <% end %>
    </div>
    <h2 class="text-2xl font-bold"><%= link_to activity.title, activity, data: {turbo: false} %></h2>
    <p class="font-light text-sm text-muted-foreground mb-3">
      Posté par <%= link_to activity.user.username, activity.user, data: {turbo: false} %>, le <time datetime="<%= activity.created_at %>"><%= activity.created_at %></time>
    </p>
  </header>
  <aside class="flex justify-between items-center p-3 mt-3 container mx-auto">
    <%= render partial: "activities/commenters", locals: {commenters: activity.commenters} %>
  </aside>
  <%= content if local_assigns.has_key? :content %>
</article>
