<article class="rounded-lg bg-blue-100" style="view-transition-name:activity-<%= activity.id %>">
  <div class="<%= classes if local_assigns.has_key? :classes %>">
      <header class="border border-b p-3 container mx-auto">
        <div class="mb-3">
          <% activity.tags.each do |tag| %>
            <%= render(TagComponent.new(tag.name, variant: :outline)) %>
          <% end %>
        </div>
        <h2 class="text-2xl font-bold"><%= link_to activity.title, activity, data: { turbo_frame: "_top" } %></h2>
        <p class="font-light text-sm text-muted-foreground mb-3">
          Posté par <%= link_to activity.user.username, activity.user, data: { turbo_frame: "_top" } %>, le <time datetime="<%= activity.created_at %>"><%= activity.created_at %></time>
        </p>
      </header>
      <aside class="flex justify-between items-center p-3 mt-3 container mx-auto">
        <%= render partial: "activities/commenters", locals: {commenters: activity.commenters} %>
        <div class="flex space-x-3">
          <%= render partial: "favorites/btn", locals: {activity_id: activity.id} %>
          <%= render partial: "practiced_activities/add", locals: {activity_id: activity.id} %>
        </div>
      </aside>
    </div>
    <%= content if local_assigns.has_key? :content %>
</article>
