<header>
  <h1 class="h1 mt-6">Mot de passe oublié ?</h1>
</header>

<div class="mt-8">
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

  <%= form_with url: passwords_path, builder: TailwindFormBuilder do |form| %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "votre@email.com", value: params[:email_address] %><br>
    <%= form.submit "Envoyer le lien de réinitialisation" %>
  <% end %>
  <p class="mt-4 text-sm text-muted-foreground">
    Vous vous en souvenez finalement ?
    <%= link_to "Connectez-vous", new_session_path, class: "font-medium text-primary underline-offset-2 hover:underline" %>.
  </p>
</div>
