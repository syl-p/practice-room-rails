<%
  field_name = local_assigns[:field_name] || 'tag_labels'
  preselected_tags = local_assigns[:preselected_tags] || []
  preselected_tags = preselected_tags.map do |tag|
    { id: tag.id, name: tag.name }
  end
%>

<div class="form-group">
  <label class="form-label">Tags</label>
  <div class="form-autocomplete"
       data-controller="tags-selector"
       data-tags-selector-tag-classes-value="chip"
       data-tags-selector-close-btn-classes-value="btn btn-clear"
       data-tags-selector-search-url-value="<%= tags_path %>"
       data-tags-selector-preselected-tags-value="<%= preselected_tags.pluck(:name).to_json %>">

    <input type="hidden" data-tags-selector-target="dataToSend" />

    <!-- autocomplete input container -->
    <div class="form-autocomplete-input form-input">
      <div data-tags-selector-target="listToShow">
      </div>

      <!-- autocomplete real input box -->
      <input type="text" name="search" placeholder="typing here" class="form-input"
             data-tags-selector-target="input"
             data-action="input->tags-selector#search change->tags-selector#selectTag"/>
    </div>

    <!-- autocomplete suggestion list -->
    <%= turbo_frame_tag :tags %>
  </div>
</div>