<% if @tags.present? %>
        <%= turbo_stream.update :tag_list do %>
            <ul class="w-full static shadow">
              <% @tags.each do |tag| %>
                <li>
                  <a class="block px-4 py-2 text-sm text-gray-700 hover:bg-accent cursor-pointer"
                     data-tags-selector-value-param="<%= tag.name %>"
                     data-action="click->tags-selector#selectTag"><%= tag.name %></a>
                </li>
              <% end %>
            </ul>
        <% end %>
<% end %>