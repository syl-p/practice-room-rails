<!DOCTYPE html>
<html>
  <head>
    <%= render partial: "shared/head" %>
  </head>

  <body data-controller="application">
    <%#= render partial: "shared/nav" %>
    <%= render partial: "shared/flash" %>

    <main class="md:pl-20 h-full relative">
      <%= render partial: "shared/narrow_sidebar" %>
      <section class="flex w-full items-stretch gap-x-0 relative">
        <div class="flex-1 relative">
          <%= render partial: "shared/practicing_nav" %>
          <div class="p-8">
            <%= yield %>
          </div>
        </div>

        <% if authenticated? && params[:practice_id] %>
          <aside
            id="practice-sidebar"
            class="z-[110] lg:z-0 h-screen hidden fixed right-0 bottom-0 w-96 shrink-0 xl:static xl:block"
            data-application-target="sidebar"
            data-transition-enter="transform transition ease-in-out duration-500"
            data-transition-enter-start="translate-x-full"
            data-transition-enter-end="translate-x-0"
            data-transition-leave="transform transition ease-in-out duration-500"
            data-transition-leave-start="translate-x-0"
            data-transition-leave-end="translate-x-full">
            <div class="fixed w-96 h-full right-0 bottom-0 bg-light shadow px-4 overflow-hidden bg-white pt-20">
              <%= turbo_frame_tag :practiced_activities,
                                  src: practice_practiced_activities_path(practice_id: params[:practice_id]),
                                  loading: :lazy do %>
                ...
              <% end %>
            </div>
          </aside>
        <% end %>
      </section>
    </main>

    <%= turbo_frame_tag :remote_modal %>
    <div
      data-application-target="overlay"
      data-transition-enter="ease-in-out duration-500"
      data-transition-enter-start="opacity-0"
      data-transition-enter-end="opacity-100"
      data-transition-leave="ease-in-out duration-500"
      data-transition-leave-start="opacity-100"
      data-transition-leave-end="opacity-0"
      class="hidden inset-0 bg-gray-500 bg-opacity-75 transition-opacity fixed left-0 top-0 w-full h-screen z-[50]"></div>
  </body>
</html>
