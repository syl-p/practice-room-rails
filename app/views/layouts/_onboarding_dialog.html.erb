<dialog data-controller="remote-modal" class="backdrop:bg-background/80 backdrop:backdrop-blur-sm w-[calc(100%-1.5rem)] lg:w-[900px] max-w-full max-h-[85dvh] border bg-background shadow-lg duration-200 rounded-md">
	<%= form_with model: model, url: url, method: method, builder: TailwindFormBuilder, **local_assigns.fetch(:form_options, {}) do |f| %>
		<div class="flex flex-col max-h-[85dvh]">
			<div class="px-6 py-4 border-b shrink-0">
				<%= header %>
			</div>
			<div class="flex-1 overflow-y-auto px-6 py-4 min-h-0">
				<%= yield f %>
			</div>
			<div class="flex items-center justify-end gap-2 px-6 py-4 border-t shrink-0">
				<%= footer.call(f) %>
			</div>
		</div>
	<% end %>
</dialog>
