<%= render DropdownComponent.new(variant: :ghost) do |component| %>
  <% component.with_trigger_btn do %>
    <%= icon "ellipsis-horizontal" %>
  <% end %>

  <% component.with_dropdown_menu do %>
    <%= render MenuComponent.new() do |menu| %>
      <% if can? comment, :update? %>
        <%= menu.with_item(href: edit_comment_path(comment)) do %>
          Editer
        <% end %>
       <% end %>

      <% if can? comment, :destroy? %>
        <%= menu.with_item(href: comment_path(comment), method: :delete, data: {turbo: false}) do %>
          Supprimer
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
