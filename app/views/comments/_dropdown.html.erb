<%= render DropdownComponent.new(variant: :ghost) do |component| %>
  <% component.with_trigger_btn do %>
    <%= icon "ellipsis-horizontal" %>
  <% end %>

  <% component.with_dropdown_menu do %>
    <ul class="py-1" role="none">
      <% if can? comment, :update? %>
        <li><%= link_to "Editer", edit_comment_path(comment) %></li>
      <% end %>

      <% if can? comment, :delete? %>
        <li><%= button_to comment_path(comment), method: :delete, data: {turbo: false} do %>
            Supprimer
          <% end %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>