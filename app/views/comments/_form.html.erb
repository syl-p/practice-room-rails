<% model = [local_assigns[:commentable], comment].compact %>
<%= form_with model:, id: record_id_gen(*model), class: "#{local_assigns[:class]}", data: {
  turbo: true,
  comment_target: "form"
}, builder: TailwindFormBuilder do |f| %>
  <%= f.text_area :content, class: "mb-3" %>

  <%= f.submit "Commenter", data: {
    action: 'click->comment#submit',
  } %>

  <% if comment.persisted? %>
    <%= link_to "Annuler", comment %>
  <% end %>
<% end %>