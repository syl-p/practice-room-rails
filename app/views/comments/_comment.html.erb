<%= turbo_frame_tag dom_id(comment) do %>
  <article class="tile mt-2"
     data-author="<%= comment.user.username %>"
     <% if comment.parent_id.nil? %>
       data-controller="comment"
       data-comment-hidden-classes-value="d-hide"
     <% end %>>
    <div class="tile-icon">
      <%= link_to comment.user, data: {turbo: false}, class: "mr-3" do %>
        <%= render(AvatarComponent.new(user: comment.user)) %>
      <% end %>
    </div>
    <div class="tile-content">
      <p class="text-muted">
        <time pubdate datetime="<%= comment.created_at %>" title="<%= comment.created_at %>">
          il y a <%= time_ago_in_words comment.created_at %>
        </time>
      </p>

      <p><%== comment.content %></p>

      <p>
        <% if authenticated? %>
          <a href="" data-action="click->comment#display">Répondre</a>
        <% end %>
      </p>

      <div>
        <% if comment.parent_id.nil? && authenticated? %>
          <%= turbo_frame_tag record_id_gen(comment, Comment.new) do %>
            <%= render partial: "comments/form", locals: {commentable: comment, comment: Comment.new, class: 'd-hide'} %>
          <% end %>
        <% end %>

        <%= turbo_frame_tag "#{dom_id(comment)}_comments" do %>
          <%=  render partial: "comments/comment", collection: comment.replies, as: :comment  %>
        <% end %>
      </div>
    </div>
    <div class="tile-action">
      <% if authenticated? %>
        <%= render partial: "comments/dropdown", locals: {comment: } %>
      <% end %>
    </div>
  </article>
<% end %>