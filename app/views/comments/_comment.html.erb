<%= turbo_frame_tag dom_id(comment) do %>
  <article
    class="comment py-5"
    data-author="<%= comment.user.username %>"
    <% if comment.parent_id.nil? %>
    data-controller="comment" data-comment-comment-outlet=".comment"
    <% end %>
    >
    <div class="flex items-start gap-3">
      <%= link_to comment.user, data: {turbo: false}, class: "shrink-0" do %>
        <%= render(AvatarComponent.new(user: comment.user)) %>
      <% end %>

      <div class="min-w-0 flex-1">
        <header class="flex items-center justify-between gap-2">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
            <%= link_to comment.user.username, comment.user, data: {turbo: false}, class: "text-sm font-semibold text-foreground hover:underline" %>
            <time pubdate datetime="<%= comment.created_at %>" title="<%= comment.created_at %>" class="text-xs text-muted-foreground">
              il y a <%= time_ago_in_words comment.created_at %>
            </time>
          </div>

          <% if authenticated? %>
            <%= render partial: "comments/dropdown", locals: {comment:} %>
          <% end %>
        </header>

        <div class="mt-1.5 text-sm leading-relaxed text-foreground/90 [&_a]:font-medium [&_a]:text-primary [&_a:hover]:underline">
          <%== comment.content %>
        </div>

        <% if authenticated? %>
          <div class="mt-2">
            <button type="button" data-action="click->comment#display"
                    class="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-primary">
              <%= icon "arrow-uturn-left", class: "size-3.5" %>
              Répondre
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <% if comment.parent_id.nil? || comment.replies.any? %>
      <div class="mt-4 ml-4 space-y-1 border-l-2 border-border pl-4">
        <%= turbo_frame_tag "#{dom_id(comment)}_comments" do %>
          <%= render partial: "comments/comment", collection: comment.replies, as: :comment %>
        <% end %>

        <% if comment.parent_id.nil? && authenticated? %>
          <%= turbo_frame_tag record_id_gen(comment, Comment.new) do %>
            <%= render partial: "comments/form", locals: {commentable: comment, comment: Comment.new, class: "hidden", label: "Votre réponse"} %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </article>
<% end %>
