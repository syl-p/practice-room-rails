<%= render layout: "layouts/remote_modal" do %>
	<%= form_with url: search_path, method: "get", builder: TailwindFormBuilder, data: {controller: "search"} do |f| %>
		<%= f.text_field :term, label: "Recherche", autofocus: true,
			placeholder: "Rechercher une pratique, une activité, un utilisateur…",
			data: {
			turbo: true,
			search_target: "input",
			action: "input->search#change"} %>
	<% end %>
	<%= turbo_frame_tag "search_results" %>
<% end %>