<%= turbo_frame_tag "search_results" do %>
  <span class="d-block mt-2">Utilisateurs:</span>
  <ul class="d-flex gap-3">
    <% @results[:users].each do |user| %>
      <li>
        <%= link_to user, data: {turbo: false} do %>
          <%= render AvatarComponent.new(user:) %>
          <span class="d-hide"><%= user.username %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <span class="d-block mt-2">Activités:</span>
  <ul>
    <% @results[:activities].each do |activity| %>
      <li>
        <%= link_to activity.title, activity, data: {turbo: true, turbo_frame: :remote_modal}, class: "block p-4" %>
      </li>
    <% end %>
  </ul>
<% end %>