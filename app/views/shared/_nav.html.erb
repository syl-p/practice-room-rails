<header data-turbo-permanent class="fixed top-0 z-50 w-full"
>
  <div class="container flex h-14 items-center justify-between">
    <div class="mr-4 flex">
      <a class="mr-6 flex items-center space-x-2" href="/">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-6 w-6">
          <rect width="256" height="256" fill="none" />
          <line
            x1="208"
            y1="128"
            x2="128"
            y2="208"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
            />

          <line
            x1="192"
            y1="40"
            x2="40"
            y2="192"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
            />

        </svg>
        <span class="font-bold sr-only">Practice room</span>
      </a>

      <% if authenticated? %>
        <%= form_with url: switch_practice_path do %>
          <%= select_tag :practice_id,
                         options_from_collection_for_select(Current.user.practices, :id, :name, session[:current_practice_id]),
                         onchange: 'this.form.submit()' %>
        <% end %>
      <% end %>
    </div>
    <div class="flex-1">
      <%= render partial: "shared/time_today" if authenticated? %>
    </div>
    <div class="flex items-center space-x-2 justify-end">
      <nav class="flex items-center space-x-3 items-center">
        <%= render partial: "shared/search_dialog" %>
        <% if authenticated? %>
          <%= link_to new_activity_path, class: ['hidden md:block', TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::OUTLINE_CLASSES].join(' ') do %>
            +
          <% end %>
          <%= render partial: "shared/user_dropdown" %>
        <% else %>
          <%= link_to "Se connecter", new_session_path, class: "btn btn-link" %>
        <% end %>
      </nav>
    </div>
  </div>
</header>