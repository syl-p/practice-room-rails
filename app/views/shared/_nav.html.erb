<header data-turbo-permanent class="h-20 py-4 sticky w-full top-0 left-0 z-50 w-full">
  <div class="px-8 flex items-center justify-between">
    <div class="flex justify-center items-center space-x-3">
      <%= link_to "PRM.", root_path, class: "text-2xl" %>
      <% if authenticated? && params[:id] %>
        <%= turbo_frame_tag "user_practices" do %>
          <%= render partial: "shared/user_practices"%>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center space-x-2 justify-end">
      <nav class="flex items-center space-x-3 items-center">
        <% if authenticated? %>
          <%= render partial: "shared/search_dialog" %>
          <%= render partial: "shared/notifications" %>
          <%= render partial: "shared/user_dropdown" %>
          <button
            class="<%= [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::OUTLINE_CLASSES, 'lg:hidden'].join(' ')%> "
            data-action="click->application#toggle"
            data-application-id-param="practice-sidebar">
            open
          </button>
        <% else %>
          <%= link_to "se connecter", new_session_path, data: {turbo: false} %>
        <% end %>
      </nav>
    </div>
  </div>
</header>