<header data-turbo-permanent data-controller="search-shortcut" class="supports-backdrop-blur:bg-background/60 fixed top-0 z-40 w-full border-b bg-background/95 backdrop-blur">
  <div class="container mx-auto flex space-x-3 h-14 items-center">
    <div class="flex-1">
      <% if authenticated? %>
        <%= turbo_frame_tag "user_practices" do %>
          <%= render partial: "shared/user_practices" %>
        <% end %>
      <% end %>
    </div>

    <nav class="flex items-center space-x-3 justify-end">
      <% if authenticated? %>
        <%= render partial: "shared/search_dialog" %>
        <%= render partial: "shared/notifications" %>
        <%= render partial: "shared/user_dropdown" %>
      <% else %>
        <%= link_to "se connecter", new_session_path, data: {turbo: false} %>
      <% end %>
    </nav>
  </div>
</header>
