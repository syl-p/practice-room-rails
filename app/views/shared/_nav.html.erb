<header data-turbo-permanent class="fixed top-0 z-50 w-full"
>
  <div class="px-8 flex h-14 items-center justify-between">
    <div class="mr-4 flex justify-center items-center space-x-3">
      <%= link_to root_path do %>
        Pr.
      <% end %>
      <% if authenticated? && params[:practice_id] %>
        <%= turbo_frame_tag "user_practices" do %>
          <%= render partial: "shared/user_practices"%>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center space-x-2 justify-end">
      <nav class="flex items-center space-x-3 items-center">
        <% if authenticated? %>
          <%= render partial: "shared/search_dialog" %>
          <%= link_to new_activity_path,
                      class: ['hidden md:block', TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::OUTLINE_CLASSES].join(' ') do %>
            +
          <% end %>
          <%= render partial: "shared/notifications" %>
          <%= render partial: "shared/user_dropdown" %>
          <button
            class="<%= [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::OUTLINE_CLASSES, 'lg:hidden'].join(' ')%> "
            data-action="click->application#toggle"
            data-application-id-param="practice-sidebar">
            open
          </button>
        <% else %>
          <%= link_to "Se connecter", new_session_path, class: "btn btn-link", data: {turbo: false} %>
        <% end %>
      </nav>
    </div>
  </div>
</header>