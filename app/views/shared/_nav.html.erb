<header data-turbo-permanent class="navbar py-2 container grid-xl">
  <div class="navbar__section">
    <%= link_to "PRM", root_path, class: "navbar__brand", data: {turbo: false} %>
  </div>

  <div class="navbar__section navbar__center u-d-sm-hide">
    <% if authenticated? && params[:id] %>
      <%= turbo_frame_tag "user_practices" do %>
        <%= render partial: "shared/user_practices" %>
      <% end %>
    <% end %>
  </div>

  <div class="navbar__section">
    <nav class="u-d-flex u-gap-1">
      <% if authenticated? %>
        <%= render partial: "shared/search_dialog" %>
        <%= render partial: "shared/notifications" %>
        <%= render partial: "shared/user_dropdown" %>
      <% else %>
        <%= link_to "se connecter", new_session_path, data: {turbo: false} %>
      <% end %>
    </nav>
  </div>
</header>
