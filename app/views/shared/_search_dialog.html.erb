<div data-controller="search">
  <%= content_tag :button, class: [TailwindHelper::BTN_BASE_CLASSES, TailwindHelper::OUTLINE_CLASSES].join(' '),
                data: {search_target: "btn", action: "click->search#toggle"} do %>
    <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
    </svg>
    <span class="sr-only">Search</span>
  <% end %>

  <dialog data-search-target="dialog"
          data-action="click->search#closeOnSelfClick"
          class="backdrop:bg-background/80 backdrop:backdrop-blur-sm w-full md:max-w-[600px] lg:min-w-[900px] max-w-2xl gap-4 border bg-background shadow-lg duration-200 rounded-md">
    <div class="p-6">
      <%= form_with url: search_path, method: "get", builder: TailwindFormBuilder do |f| %>
        <%= f.text_field :term, data: {
          turbo: true,
          search_target: "input",
          action: "input->search#change"} %>
      <% end %>
      <%= turbo_frame_tag "search_results" %>
    </div>
  </dialog>
</div>