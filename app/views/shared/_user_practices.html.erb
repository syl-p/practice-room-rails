<%
  practices = Current.user.cached_practices
  selected_practice_id = params[:practice_id] || session[:current_practice_id]
  selected_practice = selected_practice_id.present? ? practices.find_by(id: selected_practice_id) : practices.first
  others_practices = practices - [selected_practice]
  wrapper_class = local_assigns.fetch(:wrapper_class, "")
  menu_classes = local_assigns.fetch(:menu_classes, "")
%>

<% if practices.any? && selected_practice.present? %>
  <%= render BtnGroupComponent.new(wrapper_class:) do %>
    <%= ui_action_to practice_path(selected_practice), as: :link, variant: :secondary, data: { turbo: false }, class: "min-w-0 max-w-[40vw] sm:max-w-xs flex-1 justify-center" do %>
      <span class="truncate min-w-0"><%= selected_practice.name %></span>
      <span class="hidden sm:inline shrink-0">(<%= display_time(selected_practice.duration) %>)</span>
    <% end %>

    <%= render DropdownComponent.new(variant: :outline, menu_classes:) do |component| %>
      <% component.with_trigger_btn do %>
        <%= icon "chevron-down" %>
      <% end %>

      <% component.with_dropdown_menu do %>
        <%= render MenuComponent.new do |menu| %>
          <% others_practices.each do |practice| %>
            <% menu.with_item(href: practice_path(practice.id), data: { turbo: false }) do %>
              <div class="flex items-baseline justify-between gap-2 min-w-0">
                <span class="truncate"><%= practice.name %></span>
                <span class="shrink-0 text-muted-foreground"><%= display_time(practice.duration) %></span>
              </div>
            <% end %>
          <% end %>

          <% menu.with_item(href: onboarding_practice_step_path(practice_id: selected_practice.id, step: Onboarding::Practice::STEPS.first), data: { turbo_frame: :remote_modal }) do %>
            <div class="flex items-center gap-2">
              <%= icon "pencil" %>
              <span>Modifier la pratique</span>
            </div>
          <% end %>

          <% menu.with_item(href: onboarding_practices_new_path, data: { turbo: true, turbo_frame: :remote_modal }) do %>
            <div class="flex items-center gap-2">
              <%= icon "plus" %>
              <span>Nouvelle pratique</span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>