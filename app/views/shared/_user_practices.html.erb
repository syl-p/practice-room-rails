<%
  practices = Current.user.cached_practices
  selected_practice_id = params[:practice_id] || session[:current_practice_id]
  selected_practice = selected_practice_id.present? ? practices.find_by(id: selected_practice_id) : practices.first
  others_practices = practices - [selected_practice]
%>

<% if practices.any? && selected_practice.present? %>
  <%= render BtnGroupComponent.new do %>
    <%= ui_action_to "#{selected_practice.name} (#{display_time(selected_practice.duration)})" , practice_path(selected_practice), as: :link, variant: :secondary, data: {turbo: false}, class: "overflow-hidden truncate" %>
    <%= render DropdownComponent.new(variant: :outline) do |component| %>
      <% component.with_trigger_btn do %>
        <%= icon "chevron-down" %>
      <% end %>
      <% component.with_dropdown_menu do %>
        <ul class="divide-y divide-border">
          <% others_practices.each do |practice| %>
            <li>
              <%= link_to practice_path(practice.id), class: "flex items-center px-4 py-2 hover:bg-muted", data: {turbo: false} do %>
                <%= practice.name %> (<%= display_time(practice.duration) %>)
            <% end %>
            </li>
          <% end %>
          <li>
            <%= link_to new_practice_path, class: "flex items-center space-x-3 px-4 py-2 hover:bg-muted", data: {turbo: false} do %>
              <%= icon "plus" %>
              <span class="block">Nouvelle pratique</span>
            <% end %>
          </li>
        </ul>
      <% end %>
    <% end %>
  <% end %>
<% end %>
