<div data-controller="notifications">
  <%= render DropdownComponent.new(variant: :outline) do |component| %>
    <% component.with_trigger_btn do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
           class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
      </svg>

      <span data-notifications-target="indicator"
            class="indicator hidden bottom-3 left-3 absolute w-3.5 h-3.5 bg-red-400 animate-pulse border-2 border-white dark:border-gray-800 rounded-full"></span>
    <% end %>

    <% component.with_dropdown_menu do %>
      <%= turbo_stream_from "notifications:#{Current.user.id}" %>
      <%= turbo_frame_tag "notifications" do %>
        <%= render partial: "notifications/list", locals: {notifications: Current.user.notifications.unread} %>
      <% end %>
    <% end %>
  <% end %>
</div>
