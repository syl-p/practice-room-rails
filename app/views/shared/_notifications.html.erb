<div data-controller="notifications">
  <%= render DropdownComponent.new(variant: :outline) do |component| %>
    <% component.with_trigger_btn do %>
      <span class="relative inline-flex">
        <%= icon "bell" %>
        <span data-notifications-target="indicator"
              class="indicator <%= "hidden" if Current.user.notifications.unread.none? %> absolute -top-1 -right-1 flex h-2.5 w-2.5 rounded-full bg-destructive animate-pulse ring-2 ring-background"></span>
      </span>
    <% end %>

    <% component.with_dropdown_menu do %>
      <%= turbo_stream_from "notifications:#{Current.user.id}" %>
      <%= turbo_frame_tag "notifications", id: "notifications", class: "block w-80", src: notifications_path, loading: :lazy do %>
        <div class="flex flex-col items-center gap-2 py-8 text-center">
          <%= icon "bell", class: "size-5 text-muted-foreground" %>
          <p class="text-sm text-muted-foreground">Chargement…</p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
