<%= turbo_frame_tag "flash" do %>
  <div class="flash-container">
    <% flash.each do |type, message| %>
      <%= render AlertComponent.new(variant: type) do |component| %>
        <% component.with_title do %>
          <%= type %>
        <% end %>

        <% component.with_body do %>
          <%= message %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>