<div data-controller="flash" data-flash-target="toast"
     class="opacity-100 -translate-x-full transition-transform ease-in-out duration-300 transform mb-3">
  <%= render AlertComponent.new(variant: type) do |component| %>
    <% component.with_title do %>
      <%= message %>
    <% end %>

    <% component.with_body do %>
      test !
    <% end %>
  <% end %>
</div>