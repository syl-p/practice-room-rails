<%
  dropdown_menu_links = [
    {href: edit_settings_profile_path, name: "Vos informations"},
    {href: Current.user, name: "Votre profil"},
  ]
%>

<%= render DropdownComponent.new do |component| %>
  <% component.with_trigger_btn do %>
    <%= render AvatarComponent.new(user: Current.user, size: :sm) %>
    <span class="hidden lg:block">
      <%= Current.user.username %>
    </span>
    <span class="sr-only">Ouvrir le menu utilisateur</span>
  <% end %>

  <% component.with_dropdown_menu do %>
    <%= render MenuComponent.new do |menu| %>
      <%= menu.with_item() do %>
        <p class="truncate">
          <span class="block text-xs text-muted-foreground" role="none">Connecté en tant que...</span>
          <span class="mt-0.5 font-semibold" role="none">
            <%= Current.user.username %>
          </span>
        </p>
      <% end %>

      <%= menu.with_item(href: edit_settings_profile_path) do %>
        Vos informations
      <% end %>
      <%= menu.with_item(href: Current.user) do %>
        Votre profil
      <% end %>
      <%= menu.with_item(href: session_path, method: :delete) do %>
        Se déconnecter
      <% end %>
    <% end %>
  <% end %>
<% end %>
