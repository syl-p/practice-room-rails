<%
  dropdown_menu_links = [
    {href: edit_settings_profile_path, name: "Vos informations"},
    {href: Current.user, name: "Votre profil"},
  ]
%>

<%= render DropdownComponent.new(variant: :outline) do |component| %>
  <% component.with_trigger_btn do %>
    <%= render AvatarComponent.new(user: Current.user) %>
    <span>
      <%= Current.user.username %>
    </span>
  <% end %>

  <% component.with_dropdown_menu do %>
    <ul class="menu" role="none">
      <li class="menu__item">
        <p>
          <span class="d-block" role="none">Connecté en tant que...</span>
          <span role="none">
            <%= Current.user.username %>
          </span>
        </p>
      </li>
      <li class="divider" data-content="Vos préférences"></li>
      <% dropdown_menu_links.each do |link| %>
        <li class="menu__item">
          <%= link_to link[:name], link[:href] %>
        </li>
      <% end %>
      <li class="menu__item">
        <%= button_to "Se déconnecter", session_path, method: :delete, class: "btn btn--link p-0" %>
      </li>
    </ul>
  <% end %>
<% end %>