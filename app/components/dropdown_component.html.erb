<div class="relative dropdown" data-controller="dropdown">
  <button
    type="button"
    class="<%= variant_class_name %>"
    data-dropdown-target="triggerBtn"
    data-action="click->dropdown#toggle"
  >
    <%= trigger_btn %>
  </button>
  <div
    class="hidden absolute right-0 z-10 mt-4 min-w-56 bg-white rounded-md ring-1 ring-black ring-opacity-5 shadow-lg origin-top-right focus:outline-none"
    data-dropdown-target="dropdownMenu"
  >
    <%= dropdown_menu %>
  </div>
</div>