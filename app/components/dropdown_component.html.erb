<div class="popover popover-bottom">
  <button
    type="button"
    class="btn"
    data-dropdown-target="triggerBtn"
    data-action="click->dropdown#toggle"
  >
    <%= trigger_btn %>
  </button>
  <div
    class="popover-container"
    data-dropdown-target="dropdownMenu"
  >
    <%= dropdown_menu %>
  </div>
</div>