<div class="flex items-center gap-4 rounded-xl border border-border bg-background p-4 shadow-sm">
  <div class="relative inline-flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden">
    <svg class="h-20 w-20" viewBox="0 0 80 80">
      <!-- Background circle -->
      <circle
        r="<%= normalized_radius %>"
        cx="40"
        cy="40"
        stroke-width="<%= stroke %>"
        stroke="currentColor"
        class="text-border"
        fill="transparent"
        />
      <!-- Progress circle -->
      <circle
        class="<%= color_classes %> transition-all duration-500"
        r="<%= normalized_radius %>"
        cx="40"
        cy="40"
        stroke-width="<%= stroke %>"
        stroke-dasharray="<%= circumference %>"
        stroke-dashoffset="<%= stroke_dash_offset %>"
        stroke-linecap="round"
        stroke="currentColor"
        fill="transparent"
        transform="rotate(-90 40 40)"
        />
    </svg>
    <span class="absolute <%= color_classes %> text-sm font-bold"><%= "#{progress}%" %></span>
  </div>
  <div class="min-w-0">
    <p class="text-base font-bold leading-tight text-foreground"><%= label_title %></p>
    <p class="mt-1 text-sm text-muted-foreground"><%= label_subtitle %></p>
  </div>
</div>