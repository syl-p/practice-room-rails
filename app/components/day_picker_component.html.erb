<nav id="date_picker" class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-background px-2 py-2.5 shadow-sm sm:px-3">
  <div class="flex items-center justify-between gap-1 sm:gap-2">
    <%= link_to path_for(previous_week), class: "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-foreground sm:h-9 sm:w-9", aria: { label: "Semaine précédente" } do %>
      <%= icon("chevron-left", class: "size-4") %>
    <% end %>

    <ul class="grid flex-1 grid-cols-7 items-center gap-1 sm:gap-1.5">
      <% (@start_at..@end_at).each do |wd| %>
        <li id="<%= wd %>" class="w-full min-w-0">
          <% day_dom = capture do %>
            <span class="block text-[10px] uppercase tracking-wide sm:text-[11px]"><%= I18n.l(wd, format: "%a") %></span>
            <span class="block text-sm font-semibold leading-6 sm:text-base"><%= wd.day %></span>
            <span class="hidden text-[11px] opacity-80 sm:block"><%= I18n.l(wd, format: "%b") %></span>
          <% end %>

          <% if wd.future? %>
            <div class="block w-full min-w-0 cursor-not-allowed rounded-xl border border-border bg-background px-1 py-1.5 text-center opacity-50 sm:px-1.5">
              <%= day_dom %>
            </div>
          <% else %>
            <%= link_to path_for(wd), class: day_classes(wd), aria: ({ current: "date" } if active?(wd)) do %>
              <%= day_dom %>
              <% if has_entries?(wd) %>
                <%= render TooltipComponent.new(helpers.display_time(entries_duration_for(wd)), position: :right) do %>
                  <span class="mx-auto mt-0.5 block h-1.5 w-1.5 rounded-full bg-highlight"></span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%= link_to path_for(next_week), class: "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-foreground sm:h-9 sm:w-9", aria: { label: "Semaine suivante" } do %>
      <%= icon("chevron-right", class: "size-4") %>
    <% end %>
  </div>
</nav>