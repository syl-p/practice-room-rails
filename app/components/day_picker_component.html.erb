<nav id="date_picker", class="flex space-x-1 items-center justify-center">
	<%= link_to path_for(previous_week) do %>
		<%= icon("chevron-left") %>
	<% end %>
  <ul class="flex flex-nowrap space-x-2 items-center justify-center">
    <% (@start_at..@end_at).each do |wd| %>
      <li id="<%= wd %>">
        <% day_dom = capture do %>
          <span class="block text-xs uppercase"><%= I18n.l(wd, format: "%a") %></span>
          <span class="block text-sm"><%= wd.day %></span>
          <span class="block text-xs"><%= I18n.l(wd, format: "%b") %></span>
        <% end %>

        <% if wd.future? %>
          <div class="block text-center p-1 rounded-lg border relative cursor-not-allowed opacity-60">
            <%= day_dom %>
          </div>
        <% else %>
          <%= link_to path_for(wd), class: day_classes(wd) do %>
            <%= day_dom %>
            <% if has_entries?(wd) %>
							<%= render TooltipComponent.new("#{helpers.display_time(entries_duration_for(wd))}", position: :right) do %>
								<div class="rounded-full bg-primary w-3 h-3 p-1"></div>
							<% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
	<%= link_to path_for(next_week) do %>
		<%= icon("chevron-right") %>
	<% end %>
</nav>