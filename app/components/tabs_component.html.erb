<div
    data-controller="tabs"
    data-tabs-active-class="active"
    data-tabs-default-value="<%= default %>">
  <div class="h-10 mb-6 rounded-md bg-muted p-1 text-muted-foreground flex space-x-3 max-w-full overflow-x-auto sm:w-full snap-x snap-mandatory" style="grid-template-columns: repeat(<%= tabs.count %>, minmax(120px, 1fr))">
    <% tabs.each_with_index do |tab, index| %>
      <button class="<%= tab.button_class %> items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm flex-1 snap-start"
              data-tabs-target="tab" data-action="click->tabs#select" data-index="<%= index %>">
        <%= tab.label %>
      </button>
    <% end %>
  </div>

  <div class="tabs-content">
    <% tabs.each_with_index do |tab, index| %>
      <div data-tabs-target="panel" data-index="<%= index %>" hidden>
        <%= tab %>
      </div>
    <% end %>
  </div>
</div>
