<%
	base_classes = "block px-4 py-2 text-sm text-foreground hover:bg-muted"
	classes = @html_options[:class] ? "#{base_classes} #{@html_options.delete(:class)}" : base_classes
%>

<% if button? %>
  <%= button_to @href, method: @method, **@html_options,
        class: classes do %>
    <%= content %>
  <% end %>
<% elsif link? %>
  <%= link_to @href, **@html_options,
        class: classes do %>
    <%= content %>
  <% end %>
<% else %>
	<%= content_tag :div, **@html_options, class: classes, role: "none" do %>
		<%= content %>
	<% end %>
<% end %>
