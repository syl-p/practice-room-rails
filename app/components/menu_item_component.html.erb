<% if button? %>
  <%= button_to @href, method: @method,
        class: "block w-full text-left px-4 py-2 text-sm text-foreground hover:bg-muted cursor-pointer" do %>
    <%= content %>
  <% end %>
<% elsif link? %>
  <%= link_to @href,
        class: "block px-4 py-2 text-sm text-foreground hover:bg-muted" do %>
    <%= content %>
  <% end %>
<% else %>
  <div class="block px-4 py-2 text-sm text-foreground" role="none">
    <%= content %>
  </div>
<% end %>
